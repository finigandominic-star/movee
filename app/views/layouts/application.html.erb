<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <%# SEO: views can set content_for :title / :description; only the public landing page is indexable %>
    <% site_name = "Moveee" %>
    <% page_title = content_for?(:title) ? "#{content_for(:title)} | #{site_name}" : "#{site_name} | Property chain tracking for UK estate agents" %>
    <% page_description = content_for?(:description) ? content_for(:description) : "Moveee gives UK estate agents full visibility of every property chain, flags blind spots early and helps drive sales from offer to completion." %>
    <% indexable = controller_name == "pages" && action_name == "home" %>
    <% canonical_url = request.base_url + request.path %>

    <meta charset="utf-8">
    <title><%= page_title %></title>
    <meta name="description" content="<%= page_description %>">
    <meta name="robots" content="<%= indexable ? "index, follow" : "noindex, nofollow" %>">
    <link rel="canonical" href="<%= canonical_url %>">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#212161">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= site_name %>">
    <meta name="mobile-web-app-capable" content="yes">

    <%# Social sharing previews %>
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= site_name %>">
    <meta property="og:locale" content="en_GB">
    <meta property="og:title" content="<%= page_title %>">
    <meta property="og:description" content="<%= page_description %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= request.base_url %>/icon.png">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= page_title %>">
    <meta name="twitter:description" content="<%= page_description %>">
    <meta name="twitter:image" content="<%= request.base_url %>/icon.png">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload", media: "all" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a href="#main-content" class="visually-hidden-focusable btn btn-accent position-absolute m-2" style="z-index: 2000;">Skip to content</a>
    <%= render "shared/navbar" %>

    <% if notice || alert %>
      <div class="flash-stack" aria-live="polite">
        <% if notice %>
          <div class="alert alert-success alert-dismissible fade show" role="status">
            <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i><%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
        <% if alert %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i><%= alert %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
      </div>
    <% end %>

    <main id="main-content" class="page-main">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
