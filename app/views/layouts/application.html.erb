<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Movee" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Movee">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload", media: "all" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <a href="#main-content" class="visually-hidden-focusable btn btn-accent position-absolute m-2" style="z-index: 2000;">Skip to content</a>
    <%= render "shared/navbar" %>

    <% if notice || alert %>
      <div class="flash-stack" aria-live="polite">
        <% if notice %>
          <div class="alert alert-success alert-dismissible fade show" role="status">
            <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i><%= notice %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
        <% if alert %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i><%= alert %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% end %>
      </div>
    <% end %>

    <main id="main-content" class="page-main">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
