<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Movee" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Movee">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT" crossorigin="anonymous">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload", media: "all" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-3">
      <div class="container">
        <%= link_to root_path, class: "navbar-brand fw-bold text-primary d-flex align-items-center gap-2" do %>
          <i class="fa-solid fa-house-chimney"></i>
          <span>Movee</span>
        <% end %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            <li class="nav-item">
              <%= link_to "Properties", properties_path, class: "nav-link #{'active fw-semibold' if controller_name == 'properties'}" %>
            </li>
            <li class="nav-item">
              <%= link_to "Transactions", transactions_path, class: "nav-link #{'active fw-semibold' if controller_name == 'transactions'}" %>
            </li>
            <li class="nav-item">
              <%= link_to "Involved Parties", involved_parties_path, class: "nav-link #{'active fw-semibold' if controller_name == 'involved_parties'}" %>
            </li>
          </ul>

          <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center gap-2">
            <% if user_signed_in? %>
              <li class="nav-item d-flex align-items-center me-2">
                <span class="navbar-text small text-dark fw-medium">
                  <i class="fa-solid fa-circle-user text-primary me-1"></i>
                  <%= current_user.user_name.presence || current_user.email %>
                </span>
              </li>
              <li class="nav-item">
                <%= link_to edit_user_registration_path, class: "btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1", title: "Account Settings" do %>
                  <i class="fa-solid fa-gear"></i>
                  <span>Settings</span>
                <% end %>
              </li>
              <li class="nav-item">
                <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" do %>
                  <i class="fa-solid fa-arrow-right-from-bracket"></i>
                  <span>Sign Out</span>
                <% end %>
              </li>
            <% else %>
              <li class="nav-item">
                <%= link_to "Log In", new_user_session_path, class: "btn btn-sm btn-outline-primary" %>
              </li>
              <li class="nav-item">
                <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-sm btn-primary shadow-sm" %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </nav>

    <!-- Flash Notifications -->
    <% if notice %>
      <div class="container">
        <div class="alert alert-info alert-dismissible fade show my-2" role="alert">
          <i class="fa-solid fa-circle-info me-2"></i><%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    <% end %>

    <% if alert %>
      <div class="container">
        <div class="alert alert-danger alert-dismissible fade show my-2" role="alert">
          <i class="fa-solid fa-triangle-exclamation me-2"></i><%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      </div>
    <% end %>

    <%= yield %>
  </body>
</html>
