<nav class="navbar navbar-expand-lg navbar-movee">
  <div class="container-fluid px-4">
    <%= link_to "Moveee", root_path, class: "navbar-brand navbar-movee-brand" %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMovee" aria-controls="navbarMovee" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse justify-content-end" id="navbarMovee">
      <ul class="navbar-nav align-items-lg-center gap-lg-2">
        <% if user_signed_in? %>
          <li class="nav-item">
            <%= link_to "Properties", properties_path, class: "nav-link #{'active' if controller_name == 'properties'}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Transactions", transactions_path, class: "nav-link #{'active' if controller_name == 'transactions'}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Chains", chains_path, class: "nav-link #{'active' if controller_name == 'chains'}" %>
          </li>
          <li class="nav-item">
            <%= link_to "Involved Parties", involved_parties_path, class: "nav-link #{'active' if controller_name == 'involved_parties'}" %>
          </li>
          <li class="nav-item ms-lg-2 my-2 my-lg-0">
            <% display_name = current_user.user_name.presence || current_user.email %>
            <%= link_to edit_user_registration_path, class: "navbar-movee-avatar", title: [display_name, current_user.company.presence].compact.join(" · ") do %>
              <% if current_user.avatar.attached? %>
                <%= image_tag current_user.avatar, alt: display_name %>
              <% else %>
                <%= display_name.first.upcase %>
              <% end %>
            <% end %>
          </li>
          <li class="nav-item ms-lg-2">
            <%= button_to "Log Out", destroy_user_session_path, method: :delete, class: "btn navbar-movee-btn" %>
          </li>
        <% else %>
          <li class="nav-item">
            <%= link_to "Log In", new_user_session_path, class: "nav-link" %>
          </li>
          <li class="nav-item ms-lg-2">
            <%= link_to "Sign Up", new_user_registration_path, class: "btn navbar-movee-btn" %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</nav>
