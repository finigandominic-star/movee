<%= form_with model: involved_party, local: true, class: "needs-validation" do |f| %>
  <% if involved_party.errors.any? %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <h2 class="alert-heading h6 fw-bold mb-2">
        <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
        <%= pluralize(involved_party.errors.count, "error") %> prohibited this client from being saved:
      </h2>
      <ul class="mb-0 small ps-3">
        <% involved_party.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <section class="form-section">
    <h2 class="form-section__title">Personal details</h2>
    <div class="row g-3">
      <div class="col-12 col-md-6">
        <%= f.label :first_name, class: "form-label" do %>
          First name <span class="text-danger">*</span>
        <% end %>
        <%= f.text_field :first_name, class: "form-control #{'is-invalid' if involved_party.errors[:first_name].any?}", placeholder: "e.g. John", required: true, autofocus: true %>
        <% if involved_party.errors[:first_name].any? %>
          <div class="invalid-feedback"><%= involved_party.errors[:first_name].first %></div>
        <% end %>
      </div>

      <div class="col-12 col-md-6">
        <%= f.label :last_name, class: "form-label" do %>
          Last name <span class="text-danger">*</span>
        <% end %>
        <%= f.text_field :last_name, class: "form-control #{'is-invalid' if involved_party.errors[:last_name].any?}", placeholder: "e.g. Doe", required: true %>
        <% if involved_party.errors[:last_name].any? %>
          <div class="invalid-feedback"><%= involved_party.errors[:last_name].first %></div>
        <% end %>
      </div>

      <div class="col-12 col-md-6">
        <%= f.label :email, class: "form-label" do %>
          Email address <span class="text-danger">*</span>
        <% end %>
        <%= f.email_field :email, class: "form-control #{'is-invalid' if involved_party.errors[:email].any?}", placeholder: "john.doe@example.com", required: true %>
        <% if involved_party.errors[:email].any? %>
          <div class="invalid-feedback"><%= involved_party.errors[:email].first %></div>
        <% end %>
      </div>

      <div class="col-12 col-md-6">
        <%= f.label :phone, class: "form-label" do %>
          Phone number <span class="text-danger">*</span>
        <% end %>
        <%= f.telephone_field :phone, class: "form-control #{'is-invalid' if involved_party.errors[:phone].any?}", placeholder: "+44 7123 456789", required: true %>
        <% if involved_party.errors[:phone].any? %>
          <div class="invalid-feedback"><%= involved_party.errors[:phone].first %></div>
        <% end %>
      </div>

      <div class="col-12">
        <%= f.label :contact_info, class: "form-label" do %>
          Notes <span class="text-muted fw-normal">(optional)</span>
        <% end %>
        <%= f.text_area :contact_info, rows: 3, class: "form-control", placeholder: "e.g. Prefers WhatsApp, best reached weekday afternoons" %>
      </div>
    </div>
  </section>

  <section class="form-section client-role">
    <h2 class="form-section__title" id="clientRoleLabel">Role</h2>
    <%# Separate pills rather than .btn-group: Rails' hidden checkbox inputs break btn-group corner rounding %>
    <div class="d-flex flex-wrap gap-2" role="group" aria-labelledby="clientRoleLabel" aria-describedby="clientRoleHint">
      <%= f.check_box :seller, class: "btn-check", id: "involvedPartySellerSwitch", autocomplete: "off" %>
      <label class="btn btn-outline-primary" for="involvedPartySellerSwitch">
        <i class="fa-solid fa-house-chimney-user" aria-hidden="true"></i> Seller
      </label>
      <%= f.check_box :buyer, class: "btn-check", id: "involvedPartyBuyerSwitch", autocomplete: "off" %>
      <label class="btn btn-outline-primary" for="involvedPartyBuyerSwitch">
        <i class="fa-solid fa-key" aria-hidden="true"></i> Buyer
      </label>
    </div>
    <div class="form-text" id="clientRoleHint">Choose both if they are selling and buying.</div>

    <%# Shown only while Seller is ticked (see .onward-plans in pages/_client.scss) %>
    <fieldset class="onward-plans mt-4" aria-describedby="onwardPlansHint">
      <legend class="form-label fs-6 mb-2">After selling, are they buying another property?</legend>
      <div class="d-flex flex-wrap gap-2">
        <% InvolvedParty::ONWARD_PURCHASE_OPTIONS.each do |value, label| %>
          <%= f.radio_button :onward_purchase, value, class: "btn-check", id: "onwardPurchase_#{value}", autocomplete: "off" %>
          <label class="btn btn-outline-secondary btn-sm" for="onwardPurchase_<%= value %>"><%= label %></label>
        <% end %>
      </div>
      <div class="form-text" id="onwardPlansHint">
        Only "Not buying" closes the top of a chain. "Buying onward" also marks them as a buyer.
      </div>
    </fieldset>
  </section>

  <div class="form-actions">
    <%= link_to "Cancel", (involved_party.persisted? ? involved_party_path(involved_party) : involved_parties_path), class: "btn btn-outline-secondary" %>
    <%= f.button class: "btn btn-primary" do %>
      <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
      <span><%= local_assigns[:submit_label] || (involved_party.persisted? ? "Save changes" : "Add client") %></span>
    <% end %>
  </div>
<% end %>
