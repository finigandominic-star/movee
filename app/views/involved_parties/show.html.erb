<% party = @involved_party %>
<% can_update = policy(party).update? %>
<% added_on = party.created_at&.strftime("%d %b %Y") %>

<div class="container py-4 py-lg-5">
  <%= render layout: "shared/page_header", locals: { title: party.full_name, subtitle: safe_join([client_role_tags(party), (" · #{party.onward_purchase_label}" if party.seller?), (" · Client since #{added_on}" if added_on)].compact) } do %>
    <% if can_update && party.seller? %>
      <%= link_to new_property_path(involved_party_id: party.id), class: "btn btn-accent" do %>
        <i class="fa-solid fa-house-circle-check" aria-hidden="true"></i>
        <span>Add property for this client</span>
      <% end %>
    <% end %>
    <% if can_update && party.buyer? %>
      <%= link_to new_transaction_path(involved_party_id: party.id), class: "btn btn-accent" do %>
        <i class="fa-solid fa-handshake" aria-hidden="true"></i>
        <span>Start transaction as buyer</span>
      <% end %>
    <% end %>
    <% if can_update %>
      <%= link_to edit_involved_party_path(party), class: "btn btn-outline-primary" do %>
        <i class="fa-solid fa-pen" aria-hidden="true"></i>
        <span>Edit</span>
      <% end %>
    <% end %>
    <% if policy(party).destroy? %>
      <%= link_to involved_party_path(party), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete #{party.full_name}?" }, class: "btn btn-outline-danger btn-icon", aria: { label: "Delete client" } do %>
        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
      <% end %>
    <% end %>
  <% end %>

  <div class="row g-4">
    <div class="col-12 col-lg-8 d-flex flex-column gap-4">
      <div class="card card--property">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
          <h2 class="h5 mb-0">Properties (as vendor) <span class="badge ms-1"><%= party.properties.size %></span></h2>
          <% unless can_update && party.seller? %>
            <%= link_to new_property_path(involved_party_id: party.id), class: "btn btn-sm btn-outline-secondary" do %>
              <i class="fa-solid fa-plus" aria-hidden="true"></i>
              <span>Add property</span>
            <% end %>
          <% end %>
        </div>

        <div class="card-body">
          <% if party.properties.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <caption class="visually-hidden">Properties this client is selling</caption>
                <thead>
                  <tr>
                    <th scope="col">Address</th>
                    <th scope="col">Post code</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% party.properties.each do |property| %>
                    <tr>
                      <td>
                        <%= link_to property.short_address, property_path(property), class: "fw-semibold text-decoration-none" %>
                        <% if property.city.present? %>
                          <div class="small text-muted"><%= property.city %></div>
                        <% end %>
                      </td>
                      <td><%= property.post_code %></td>
                      <td>
                        <% if property.sold? %>
                          <span class="badge bg-secondary">Sold</span>
                        <% else %>
                          <span class="badge bg-success">Available</span>
                        <% end %>
                      </td>
                      <td class="text-end">
                        <div class="d-inline-flex gap-1">
                          <%= link_to property_path(property), class: "btn btn-sm btn-outline-primary btn-icon", aria: { label: "View #{property.short_address}" } do %>
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                          <% end %>
                          <% if can_update %>
                            <%= button_to unassign_property_involved_party_path(party, property.id), method: :delete, data: { turbo_confirm: "Remove #{property.short_address} from #{party.full_name}?" }, class: "btn btn-sm btn-outline-danger btn-icon", aria: { label: "Unlink #{property.short_address} from client" } do %>
                              <i class="fa-solid fa-link-slash" aria-hidden="true"></i>
                            <% end %>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted mb-0">No properties linked to this client yet.</p>
          <% end %>

          <% if can_update %>
            <details class="mt-3 small">
              <summary class="text-muted">Link an existing property</summary>
              <% if @available_properties.any? %>
                <%= form_with url: assign_property_involved_party_path(party), method: :post, class: "d-flex flex-wrap gap-2 mt-2" do |f| %>
                  <%= f.label :property_id, "Property", class: "visually-hidden" %>
                  <%= f.collection_select :property_id,
                      @available_properties,
                      :id,
                      ->(p) { "#{p.short_address}, #{p.city} (#{p.post_code})" },
                      { prompt: "Select an unlinked property" },
                      { class: "form-select form-select-sm flex-grow-1 w-auto", required: true } %>
                  <%= f.button "Link property", class: "btn btn-sm btn-outline-primary" %>
                <% end %>
              <% else %>
                <p class="text-muted mt-2 mb-0">Every property already has a vendor.</p>
              <% end %>
            </details>
          <% end %>
        </div>
      </div>

      <div class="card card--transaction">
        <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
          <h2 class="h5 mb-0">Transactions (as buyer) <span class="badge ms-1"><%= party.transactions.size %></span></h2>
          <% unless can_update && party.buyer? %>
            <%= link_to new_transaction_path(involved_party_id: party.id), class: "btn btn-sm btn-outline-secondary" do %>
              <i class="fa-solid fa-plus" aria-hidden="true"></i>
              <span>Add transaction</span>
            <% end %>
          <% end %>
        </div>

        <div class="card-body">
          <% if party.transactions.any? %>
            <div class="table-responsive">
              <table class="table table-hover align-middle">
                <caption class="visually-hidden">Transactions where this client is the buyer</caption>
                <thead>
                  <tr>
                    <th scope="col">Property</th>
                    <th scope="col">Chain</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% party.transactions.each do |tx| %>
                    <tr>
                      <td>
                        <% if tx.property %>
                          <%= link_to tx.property.short_address, transaction_path(tx), class: "fw-semibold text-decoration-none" %>
                        <% else %>
                          <%= link_to "Transaction ##{tx.id}", transaction_path(tx), class: "fw-semibold text-decoration-none" %>
                        <% end %>
                        <div class="small text-muted">Transaction #<%= tx.id %></div>
                      </td>
                      <td>
                        <% if tx.chain %>
                          <%= link_to chain_name(tx.chain), chain_path(tx.chain), class: "text-decoration-none" %>
                          <div class="small text-muted">Chain #<%= tx.chain.id %></div>
                        <% else %>
                          <span class="text-muted">—</span>
                        <% end %>
                      </td>
                      <td><span class="badge <%= tx.status_badge_class %>"><%= tx.status_label %></span></td>
                      <td class="text-end">
                        <div class="d-inline-flex gap-1">
                          <%= link_to transaction_path(tx), class: "btn btn-sm btn-outline-primary btn-icon", aria: { label: "View transaction ##{tx.id}" } do %>
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                          <% end %>
                          <% if can_update %>
                            <%= button_to unassign_transaction_involved_party_path(party, tx.id), method: :delete, data: { turbo_confirm: "Remove Transaction ##{tx.id} from #{party.full_name}?" }, class: "btn btn-sm btn-outline-danger btn-icon", aria: { label: "Unlink transaction ##{tx.id} from client" } do %>
                              <i class="fa-solid fa-link-slash" aria-hidden="true"></i>
                            <% end %>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-muted mb-0">No transactions linked to this client yet.</p>
          <% end %>

          <% if can_update %>
            <details class="mt-3 small">
              <summary class="text-muted">Link an existing transaction</summary>
              <% if @available_transactions.any? %>
                <%= form_with url: assign_transaction_involved_party_path(party), method: :post, class: "d-flex flex-wrap gap-2 mt-2" do |f| %>
                  <%= f.label :transaction_id, "Transaction", class: "visually-hidden" %>
                  <%= f.collection_select :transaction_id,
                      @available_transactions,
                      :id,
                      ->(tx) { "Transaction ##{tx.id} — #{tx.property&.short_address || 'No property'} (#{tx.status_label})" },
                      { prompt: "Select a transaction without a buyer" },
                      { class: "form-select form-select-sm flex-grow-1 w-auto", required: true } %>
                  <%= f.button "Link transaction", class: "btn btn-sm btn-outline-primary" %>
                <% end %>
              <% else %>
                <p class="text-muted mt-2 mb-0">Every transaction already has a buyer.</p>
              <% end %>
            </details>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <div class="card card--party">
        <div class="card-header">
          <h2 class="h5 mb-0">Contact details</h2>
        </div>
        <div class="card-body">
          <% if policy(party).show_personal_data? %>
            <dl class="mb-0 d-flex flex-column gap-2">
              <div class="record-meta">
                <dt>Email</dt>
                <dd><a href="mailto:<%= party.email %>" class="text-decoration-none"><%= party.email %></a></dd>
              </div>
              <div class="record-meta">
                <dt>Phone</dt>
                <dd><a href="tel:<%= party.phone %>" class="text-decoration-none"><%= party.phone %></a></dd>
              </div>
              <div class="record-meta">
                <dt>Managing agent</dt>
                <dd><%= party.user&.user_name || "—" %></dd>
              </div>
              <% if party.contact_info.present? %>
                <div>
                  <dt class="small text-muted fw-medium mb-1">Notes</dt>
                  <dd class="mb-0 small"><%= party.contact_info %></dd>
                </div>
              <% end %>
            </dl>
          <% else %>
            <p class="mb-2">
              <span class="badge bg-light"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Confidential client</span>
            </p>
            <p class="small text-muted">
              Direct contact details are only visible to the managing agent<% if party.user %>
                (<strong><%= party.user.user_name %></strong><% if party.user.company.present? %>, <%= party.user.company %><% end %>)<% end %>.
            </p>
            <% if party.user %>
              <div class="small">
                <div class="fw-semibold mb-1">Contact the managing agent</div>
                <a href="mailto:<%= party.user.email %>" class="d-block text-decoration-none">
                  <i class="fa-solid fa-envelope me-1" aria-hidden="true"></i><%= party.user.email %>
                </a>
                <% if party.user.phone.present? %>
                  <a href="tel:<%= party.user.phone %>" class="d-block text-decoration-none">
                    <i class="fa-solid fa-phone me-1" aria-hidden="true"></i><%= party.user.phone %>
                  </a>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
