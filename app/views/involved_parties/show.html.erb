<div class="container py-4">
  <!-- Breadcrumb Navigation -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item"><%= link_to "Involved Parties", involved_parties_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item active" aria-current="page"><%= @involved_party.full_name %></li>
    </ol>
  </nav>

  <!-- Page Header & Action Bar -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h1 class="h2 fw-bold text-dark mb-0"><%= @involved_party.full_name %></h1>
        <div>
          <% if @involved_party.seller? %>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6">Seller</span>
          <% end %>
          <% if @involved_party.buyer? %>
            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fs-6">Buyer</span>
          <% end %>
          <% unless @involved_party.seller? || @involved_party.buyer? %>
            <span class="badge bg-light text-muted border fs-6">General Contact</span>
          <% end %>
        </div>
      </div>
      <p class="text-muted mb-0 small">
        Client ID #<%= @involved_party.id %> • Registered on <%= @involved_party.created_at.strftime("%B %d, %Y") %>
      </p>
    </div>

    <!-- Actions -->
    <div class="d-flex gap-2">
      <%= link_to involved_parties_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to List</span>
      <% end %>

      <% if policy(@involved_party).update? %>
        <%= link_to edit_involved_party_path(@involved_party), class: "btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm" do %>
          <i class="fa-solid fa-pen"></i>
          <span>Edit Party</span>
        <% end %>
      <% end %>

      <% if policy(@involved_party).destroy? %>
        <%= link_to involved_party_path(@involved_party), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete #{@involved_party.full_name}?" }, class: "btn btn-outline-danger d-inline-flex align-items-center shadow-sm", title: "Delete Party" do %>
          <i class="fa-solid fa-trash-can"></i>
        <% end %>
      <% end %>
    </div>
  </div>

  <div class="row g-4">
    <!-- Left Column: Assigned Properties & Transactions Management -->
    <div class="col-12 col-lg-8">
      <!-- 1. Assigned Properties Section -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2">
            <h5 class="card-title fw-bold text-dark mb-0">
              <i class="fa-solid fa-house text-primary me-2"></i> Assigned Properties
            </h5>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
              <%= @involved_party.properties.size %> Assigned
            </span>
          </div>

          <%= link_to new_property_path(involved_party_id: @involved_party.id), class: "btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" do %>
            <i class="fa-solid fa-plus"></i>
            <span>New Property for this Client</span>
          <% end %>
        </div>

        <div class="card-body p-4">
          <!-- Table of Assigned Properties -->
          <% if @involved_party.properties.any? %>
            <div class="table-responsive mb-4">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                  <tr>
                    <th>Address</th>
                    <th>City & Postcode</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @involved_party.properties.each do |property| %>
                    <tr>
                      <td>
                        <div class="fw-bold text-dark">
                          <%= link_to property.short_address, property_path(property), class: "text-decoration-none text-dark" %>
                        </div>
                        <% if property.second_line_of_address.present? %>
                          <small class="text-muted"><%= property.second_line_of_address %></small>
                        <% end %>
                      </td>
                      <td>
                        <span><%= property.city %></span>
                        <span class="badge bg-light text-dark border ms-1"><%= property.post_code %></span>
                      </td>
                      <td>
                        <% if property.sold? %>
                          <span class="badge bg-secondary">Sold</span>
                        <% else %>
                          <span class="badge bg-success">Available</span>
                        <% end %>
                      </td>
                      <td class="text-end">
                        <div class="d-inline-flex gap-1">
                          <%= link_to property_path(property), class: "btn btn-sm btn-outline-primary", title: "View Property" do %>
                            <i class="fa-solid fa-eye"></i>
                          <% end %>
                          <!-- Remove / Unassign Property -->
                          <%= button_to unassign_property_involved_party_path(@involved_party, property.id), method: :delete, data: { turbo_confirm: "Remove #{property.short_address} from #{@involved_party.full_name}?" }, class: "btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1", title: "Unassign property from client" do %>
                            <i class="fa-solid fa-link-slash"></i>
                            <span class="d-none d-sm-inline">Remove</span>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="p-3 text-center text-muted bg-light rounded-3 mb-4">
              <i class="fa-solid fa-house-chimney-crack fa-2x text-secondary opacity-50 mb-2 d-block"></i>
              No properties are currently assigned to this party.
            </div>
          <% end %>

          <!-- Assign Existing Property Form -->
          <div class="p-3 bg-light rounded-3 border">
            <h6 class="fw-bold text-dark mb-2 small text-uppercase">
              <i class="fa-solid fa-link me-1 text-primary"></i> Assign Existing Property
            </h6>
            <% if @available_properties.any? %>
              <%= form_with url: assign_property_involved_party_path(@involved_party), method: :post, class: "row g-2 align-items-center" do |f| %>
                <div class="col-12 col-sm-8">
                  <%= f.collection_select :property_id,
                      @available_properties,
                      :id,
                      ->(p) { "#{p.short_address}, #{p.city} (#{p.post_code})" },
                      { prompt: "-- Select Unassigned Property --" },
                      { class: "form-select form-select-sm", required: true } %>
                </div>
                <div class="col-12 col-sm-4">
                  <%= f.button class: "btn btn-sm btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1" do %>
                    <i class="fa-solid fa-plus"></i>
                    <span>Assign Property</span>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <p class="small text-muted mb-0">All existing properties currently have assigned clients. You can create a new property or reassign from another record.</p>
            <% end %>
          </div>
        </div>
      </div>

      <!-- 2. Assigned Transactions Section -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2">
            <h5 class="card-title fw-bold text-dark mb-0">
              <i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i> Deal Transactions
            </h5>
            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">
              <%= @involved_party.transactions.size %> Associated
            </span>
          </div>

          <%= link_to new_transaction_path(involved_party_id: @involved_party.id), class: "btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" do %>
            <i class="fa-solid fa-plus"></i>
            <span>Record Transaction for this Client</span>
          <% end %>
        </div>

        <div class="card-body p-4">
          <!-- Table of Assigned Transactions -->
          <% if @involved_party.transactions.any? %>
            <div class="table-responsive mb-4">
              <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-muted">
                  <tr>
                    <th>Transaction</th>
                    <th>Property</th>
                    <th>Chain</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @involved_party.transactions.each do |tx| %>
                    <tr>
                      <td class="fw-semibold">
                        <%= link_to "##{tx.id}", transaction_path(tx), class: "text-decoration-none fw-bold" %>
                      </td>
                      <td>
                        <% if tx.property %>
                          <%= link_to tx.property.short_address, property_path(tx.property), class: "text-decoration-none text-dark fw-medium" %>
                        <% else %>
                          <span class="text-muted">—</span>
                        <% end %>
                      </td>
                      <td>
                        <% if tx.chain %>
                          <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">
                            Chain #<%= tx.chain.id %>
                          </span>
                        <% else %>
                          <span class="text-muted">—</span>
                        <% end %>
                      </td>
                      <td>
                        <span class="badge <%= tx.status_badge_class %>"><%= tx.status_label %></span>
                      </td>
                      <td class="text-end">
                        <div class="d-inline-flex gap-1">
                          <%= link_to transaction_path(tx), class: "btn btn-sm btn-outline-primary", title: "View Transaction" do %>
                            <i class="fa-solid fa-eye"></i>
                          <% end %>
                          <!-- Remove / Unassign Transaction -->
                          <%= button_to unassign_transaction_involved_party_path(@involved_party, tx.id), method: :delete, data: { turbo_confirm: "Remove Transaction ##{tx.id} from #{@involved_party.full_name}?" }, class: "btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1", title: "Unassign transaction from client" do %>
                            <i class="fa-solid fa-link-slash"></i>
                            <span class="d-none d-sm-inline">Remove</span>
                          <% end %>
                        </div>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="p-3 text-center text-muted bg-light rounded-3 mb-4">
              <i class="fa-solid fa-file-circle-xmark fa-2x text-secondary opacity-50 mb-2 d-block"></i>
              No transactions currently assigned to this party.
            </div>
          <% end %>

          <!-- Assign Existing Transaction Form -->
          <div class="p-3 bg-light rounded-3 border">
            <h6 class="fw-bold text-dark mb-2 small text-uppercase">
              <i class="fa-solid fa-link me-1 text-primary"></i> Assign Existing Transaction
            </h6>
            <% if @available_transactions.any? %>
              <%= form_with url: assign_transaction_involved_party_path(@involved_party), method: :post, class: "row g-2 align-items-center" do |f| %>
                <div class="col-12 col-sm-8">
                  <%= f.collection_select :transaction_id,
                      @available_transactions,
                      :id,
                      ->(tx) { "Transaction ##{tx.id} — #{tx.property&.short_address || 'No Property'} (#{tx.status_label})" },
                      { prompt: "-- Select Unassigned Transaction --" },
                      { class: "form-select form-select-sm", required: true } %>
                </div>
                <div class="col-12 col-sm-4">
                  <%= f.button class: "btn btn-sm btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-1" do %>
                    <i class="fa-solid fa-plus"></i>
                    <span>Assign Transaction</span>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <p class="small text-muted mb-0">No unassigned transactions available to link.</p>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Profile & Contact Summary -->
    <div class="col-12 col-lg-4">
      <!-- Contact Details Card -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="card-title fw-bold text-dark mb-0">
            <i class="fa-solid fa-address-card text-primary me-2"></i> Contact Details
          </h6>
        </div>
        <div class="card-body p-3">
          <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
              <i class="fa-solid fa-user fa-xl"></i>
            </div>
            <div>
              <h5 class="fw-bold text-dark mb-0"><%= @involved_party.full_name %></h5>
              <span class="text-muted small"><%= @involved_party.roles_label %></span>
            </div>
          </div>

          <% if policy(@involved_party).show_personal_data? %>
            <ul class="list-group list-group-flush small">
              <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                <span class="text-muted"><i class="fa-solid fa-envelope me-1"></i> Email</span>
                <a href="mailto:<%= @involved_party.email %>" class="text-decoration-none fw-medium text-truncate" style="max-width: 180px;">
                  <%= @involved_party.email %>
                </a>
              </li>
              <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                <span class="text-muted"><i class="fa-solid fa-phone me-1"></i> Phone</span>
                <a href="tel:<%= @involved_party.phone %>" class="text-decoration-none fw-medium">
                  <%= @involved_party.phone %>
                </a>
              </li>
              <% if @involved_party.contact_info.present? %>
                <li class="list-group-item px-0 py-2">
                  <span class="text-muted d-block mb-1"><i class="fa-solid fa-circle-info me-1"></i> Notes</span>
                  <p class="text-dark mb-0 small bg-light p-2 rounded"><%= @involved_party.contact_info %></p>
                </li>
              <% end %>
              <li class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center text-muted">
                <span><i class="fa-regular fa-calendar me-1"></i> Added</span>
                <span><%= @involved_party.created_at&.strftime("%d %b %Y") || "—" %></span>
              </li>
            </ul>
          <% else %>
            <div class="alert alert-warning py-3 px-3 small mb-0 border-0">
              <div class="d-flex align-items-center gap-2 mb-1">
                <i class="fa-solid fa-lock text-warning"></i>
                <span class="fw-semibold text-dark">Personal Contact Details Protected</span>
              </div>
              <p class="mb-0 text-muted">
                Direct contact information is restricted to the associated agent
                <% if @involved_party.user %>
                  (<strong><%= @involved_party.user.user_name %></strong><% if @involved_party.user.company.present? %> — <%= @involved_party.user.company %><% end %>)
                <% end %>.
              </p>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="card border-0 shadow-sm">
        <div class="card-body p-3 d-grid gap-2">
          <%= link_to edit_involved_party_path(@involved_party), class: "btn btn-outline-primary d-flex align-items-center justify-content-center gap-1" do %>
            <i class="fa-solid fa-pen"></i> Edit Party Profile
          <% end %>
          <%= link_to involved_parties_path, class: "btn btn-outline-secondary d-flex align-items-center justify-content-center gap-1" do %>
            <i class="fa-solid fa-list"></i> All Involved Parties
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
