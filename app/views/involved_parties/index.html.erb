<%# Only clients the current agent manages or is associated with are listed %>
<% parties = @involved_parties.select { |party| current_user&.admin? || party.user == current_user || party.user_associated?(current_user) } %>

<div class="container py-4 py-lg-5">
  <%= render layout: "shared/page_header", locals: { title: "Clients", subtitle: "#{pluralize(parties.size, 'client')} · buyers and sellers you act for" } do %>
    <%= link_to new_involved_party_path, class: "btn btn-primary" do %>
      <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
      <span>Add client</span>
    <% end %>
  <% end %>

  <% if parties.empty? %>
    <%= render layout: "shared/empty_state", locals: { icon: "fa-user-group", title: "No clients yet", text: "Add your buyers and sellers, then link them to properties and transactions." } do %>
      <%= link_to new_involved_party_path, class: "btn btn-primary" do %>
        <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
        <span>Add your first client</span>
      <% end %>
    <% end %>
  <% else %>
    <div class="page-toolbar">
      <ul class="nav nav-pills small" id="partyViewTabs" role="tablist" aria-label="Choose list layout">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="cards-tab" data-bs-toggle="pill" data-bs-target="#cards-view" type="button" role="tab" aria-controls="cards-view" aria-selected="true">
            <i class="fa-solid fa-grip me-1" aria-hidden="true"></i> Cards
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="table-tab" data-bs-toggle="pill" data-bs-target="#table-view" type="button" role="tab" aria-controls="table-view" aria-selected="false">
            <i class="fa-solid fa-table-list me-1" aria-hidden="true"></i> Table
          </button>
        </li>
      </ul>
    </div>

    <div class="tab-content" id="partyViewTabsContent">
      <div class="tab-pane fade show active" id="cards-view" role="tabpanel" aria-labelledby="cards-tab" tabindex="0">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xxl-4 card-grid">
          <% parties.each do |party| %>
            <% personal = policy(party).show_personal_data? %>
            <% label = personal ? party.full_name : "client ##{party.id}" %>
            <div class="col">
              <div class="card record-card card--party">
                <div class="card-header">
                  <div>
                    <h2 class="record-card__title">
                      <%= link_to involved_party_path(party) do %>
                        <% if personal %>
                          <%= party.full_name %>
                        <% else %>
                          <i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Protected Client
                        <% end %>
                      <% end %>
                    </h2>
                    <% if personal %>
                      <p class="record-card__subtitle text-truncate"><%= party.email %></p>
                    <% end %>
                  </div>
                  <div class="d-flex flex-wrap justify-content-end gap-1"><%= client_role_tags(party) %></div>
                </div>

                <div class="card-body">
                  <dl class="mb-0 d-flex flex-column gap-2">
                    <div class="record-meta">
                      <dt>Properties</dt>
                      <dd><%= party.properties.size %></dd>
                    </div>
                    <div class="record-meta">
                      <dt>Transactions</dt>
                      <dd><%= party.transactions.size %></dd>
                    </div>
                    <div class="record-meta">
                      <dt>Managing agent</dt>
                      <dd><%= party.user&.user_name || "—" %></dd>
                    </div>
                  </dl>
                </div>

                <% if policy(party).update? || policy(party).destroy? %>
                  <div class="card-footer">
                    <% if policy(party).update? %>
                      <%= link_to edit_involved_party_path(party), class: "btn btn-sm btn-outline-secondary btn-icon", aria: { label: "Edit #{label}" } do %>
                        <i class="fa-solid fa-pen" aria-hidden="true"></i>
                      <% end %>
                    <% end %>
                    <% if policy(party).destroy? %>
                      <%= link_to involved_party_path(party), data: { turbo_method: :delete, turbo_confirm: "Delete this client?" }, class: "btn btn-sm btn-outline-danger btn-icon", aria: { label: "Delete #{label}" } do %>
                        <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                      <% end %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="table-view" role="tabpanel" aria-labelledby="table-tab" tabindex="0">
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <caption class="visually-hidden">Clients</caption>
            <thead>
              <tr>
                <th scope="col">Name</th>
                <th scope="col">Contact</th>
                <th scope="col" class="text-center">Properties</th>
                <th scope="col" class="text-center">Transactions</th>
                <th scope="col" class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% parties.each do |party| %>
                <% personal = policy(party).show_personal_data? %>
                <% label = personal ? party.full_name : "client ##{party.id}" %>
                <tr>
                  <td>
                    <% if personal %>
                      <%= link_to party.full_name, involved_party_path(party), class: "fw-semibold text-decoration-none" %>
                    <% else %>
                      <span class="badge bg-light"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Protected Client</span>
                    <% end %>
                  </td>
                  <td class="small">
                    <% if personal %>
                      <a href="mailto:<%= party.email %>" class="d-block text-decoration-none"><%= party.email %></a>
                      <a href="tel:<%= party.phone %>" class="d-block text-decoration-none text-muted"><%= party.phone %></a>
                    <% else %>
                      <span class="badge bg-light mb-1"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Protected</span>
                      <% if party.user.present? %>
                        <div>Agent: <%= party.user.user_name %></div>
                        <a href="mailto:<%= party.user.email %>" class="d-block text-decoration-none text-muted"><%= party.user.email %></a>
                        <% if party.user.phone.present? %>
                          <a href="tel:<%= party.user.phone %>" class="d-block text-decoration-none text-muted"><%= party.user.phone %></a>
                        <% end %>
                      <% end %>
                    <% end %>
                  </td>
                  <td class="text-center"><%= party.properties.size %></td>
                  <td class="text-center"><%= party.transactions.size %></td>
                  <td class="text-end">
                    <div class="d-inline-flex gap-1">
                      <%= link_to involved_party_path(party), class: "btn btn-sm btn-outline-primary btn-icon", aria: { label: "View #{label}" } do %>
                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                      <% end %>
                      <% if policy(party).update? %>
                        <%= link_to edit_involved_party_path(party), class: "btn btn-sm btn-outline-secondary btn-icon", aria: { label: "Edit #{label}" } do %>
                          <i class="fa-solid fa-pen" aria-hidden="true"></i>
                        <% end %>
                      <% end %>
                      <% if policy(party).destroy? %>
                        <%= link_to involved_party_path(party), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this client?" }, class: "btn btn-sm btn-outline-danger btn-icon", aria: { label: "Delete #{label}" } do %>
                          <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
                        <% end %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>
