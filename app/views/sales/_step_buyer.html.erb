<% chosen_id = params[:existing_id].presence&.to_i || @buyer&.id %>
<% focus_new = @new_party.errors.any? || chosen_id.nil? %>
<section class="card card--party sale-step" aria-labelledby="saleStepTitle">
  <div class="card-header">
    <h2 class="h5 mb-1" id="saleStepTitle">Who is buying <%= @property.short_address %>?</h2>
    <p class="small text-muted mb-0">Add the buyer as a new client, search your existing clients, or skip if there's no buyer yet.</p>
  </div>
  <div class="card-body p-4">
    <%= render "sales/choice_error" %>
    <div class="sale-options sale-options--stacked">
      <div class="sale-option">
        <h3 class="sale-option__title">Add a new client</h3>
        <%# new shortcut: read a client PDF and fill in the form below (see ClientDocumentsController) %>
        <%= render "sales/fill_from_pdf" %>
        <%= form_with model: @new_party, scope: :involved_party, url: sale_path, method: :post, local: true do |f| %>
          <%= render "sales/carry" %>
          <div class="row g-3">
            <%= render "sales/field", f: f, record: @new_party, attr: :first_name, label: "First name", required: true, autofocus: focus_new, col: "col-12 col-sm-6" %>
            <%= render "sales/field", f: f, record: @new_party, attr: :last_name, label: "Last name", required: true, col: "col-12 col-sm-6" %>
            <%= render "sales/field", f: f, record: @new_party, attr: :email, label: "Email address", type: :email_field, required: true, placeholder: "name@example.com" %>
            <%= render "sales/field", f: f, record: @new_party, attr: :phone, label: "Phone number", type: :telephone_field, required: true, placeholder: "+44 7123 456789" %>
          </div>
          <div class="sale-option__actions">
            <button type="submit" class="btn btn-primary">Create and continue <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
          </div>
        <% end %>
      </div>

      <% if @clients.any? %>
        <div class="sale-or" role="separator"><span>or</span></div>

        <div class="sale-option sale-option--secondary">
          <h3 class="sale-option__title">Choose an existing client</h3>
          <%= form_with url: sale_path, method: :post, local: true,
                data: { controller: "client-search", action: "change->client-search#choose click@window->client-search#closeOnOutsideClick" } do %>
            <%= render "sales/carry" %>
            <label class="visually-hidden" for="buyerSearch">Search your clients by name</label>
            <div class="input-group input-group-sm mb-2">
              <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
              <input type="search" id="buyerSearch" class="form-control" placeholder="Search by name, or browse your clients…" autocomplete="off"
                     data-client-search-target="input" data-action="input->client-search#filter focus->client-search#show">
              <button type="button" class="btn btn-outline-secondary" aria-controls="buyerChoices" aria-expanded="false"
                      aria-label="Show all your clients" data-client-search-target="toggle" data-action="client-search#toggle">
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </button>
            </div>
            <fieldset>
              <legend class="visually-hidden">Your clients</legend>
              <div class="choice-list" id="buyerChoices">
                <% @clients.each do |client| %>
                  <% checked = chosen_id == client.id %>
                  <div data-client-search-target="item" data-name="<%= client.full_name %>">
                    <%= render "sales/choice", name: "existing_id", value: client.id, id: "buyer_#{client.id}",
                          checked: checked,
                          autofocus: !focus_new && checked,
                          title: client.full_name %>
                  </div>
                <% end %>
              </div>
              <p class="text-muted small mb-0" data-client-search-target="empty" hidden>No clients match that name.</p>
            </fieldset>
            <div data-client-search-target="details">
              <div class="sale-option__actions">
                <button type="submit" class="btn btn-outline-primary btn-sm">Continue with this client <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <%= render layout: "sales/step_footer" do %>
      <%= link_to "Skip — no buyer yet", new_sale_path(step: "chain", vendor_id: @vendor.id, property_id: @property.id), class: "btn btn-outline-primary" %>
    <% end %>
  </div>
</section>
