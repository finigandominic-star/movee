<%# Vendor's plans after selling. Locals: name, prefix, selected, hint %>
<fieldset class="onward-plans sale-onward">
  <legend class="form-label fs-6 mb-2">After selling, are they buying another property?</legend>
  <div class="d-flex flex-wrap gap-2">
    <% InvolvedParty::ONWARD_PURCHASE_OPTIONS.each do |value, label| %>
      <%= radio_button_tag name, value, selected == value, class: "btn-check", id: "#{prefix}_#{value}", autocomplete: "off" %>
      <label class="btn btn-outline-secondary btn-sm" for="<%= prefix %>_<%= value %>"><%= label %></label>
    <% end %>
  </div>
  <div class="form-text"><%= hint %></div>
</fieldset>
