<% chosen_id = params[:existing_id].presence&.to_i || @property&.id %>
<% focus_new = @new_property.errors.any? || chosen_id.nil? %>
<section class="card card--property sale-step" aria-labelledby="saleStepTitle">
  <div class="card-header">
    <h2 class="h5 mb-1" id="saleStepTitle">Which property is <%= @vendor.full_name %> selling?</h2>
  </div>
  <div class="card-body p-4">
    <%= render "sales/choice_error" %>
    <div class="sale-options sale-options--stacked">
      <div class="sale-option">
        <h3 class="sale-option__title">Add a new property</h3>
        <% if @address_from_document.present? %>
          <div class="alert alert-info mb-3" role="status">
            <i class="fa-solid fa-wand-magic-sparkles me-2" aria-hidden="true"></i>
            Address filled in from <strong><%= @client_document.filename %></strong> (the client's current home).
            Please check it's the property being sold.
          </div>
        <% end %>
        <%= form_with model: @new_property, scope: :property, url: sale_path, method: :post, local: true do |f| %>
          <%= render "sales/carry" %>
          <div class="row g-3">
            <%= render "sales/field", f: f, record: @new_property, attr: :house_number, label: "House / building number", required: true, autofocus: focus_new, placeholder: "e.g. 10B", col: "col-12 col-sm-5" %>
            <%= render "sales/field", f: f, record: @new_property, attr: :street, label: "Street", required: true, placeholder: "e.g. Downing Street", col: "col-12 col-sm-7" %>
            <%= render "sales/field", f: f, record: @new_property, attr: :second_line_of_address, label: "Address line 2", placeholder: "e.g. Flat 4" %>
            <%= render "sales/field", f: f, record: @new_property, attr: :city, label: "City / town", placeholder: "e.g. London", col: "col-12 col-sm-6" %>
            <%= render "sales/field", f: f, record: @new_property, attr: :post_code, label: "Postcode", required: true, placeholder: "e.g. SW1A 2AA", col: "col-12 col-sm-6" %>
            <div class="col-12">
              <%= f.label :photo, class: "form-label" do %>
                Photo <span class="text-muted fw-normal">(optional)</span>
              <% end %>
              <%= f.file_field :photo, accept: "image/*", class: "form-control #{'is-invalid' if @new_property.errors[:photo].any?}" %>
              <% if @new_property.errors[:photo].any? %>
                <div class="invalid-feedback"><%= @new_property.errors[:photo].first %></div>
              <% end %>
              <div class="form-text">Shown as the listing's preview photo.</div>
            </div>
          </div>
          <div class="sale-option__actions">
            <button type="submit" class="btn btn-primary">Create and continue <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
          </div>
        <% end %>
      </div>

      <% if @properties.any? %>
        <div class="sale-or" role="separator"><span>or</span></div>

        <div class="sale-option sale-option--secondary">
          <h3 class="sale-option__title">Choose an existing property</h3>
          <%= form_with url: sale_path, method: :post, local: true do %>
            <%= render "sales/carry" %>
            <fieldset>
              <legend class="visually-hidden">Available properties</legend>
              <div class="choice-list">
                <% @properties.each do |property| %>
                  <% checked = chosen_id == property.id %>
                  <%= render "sales/choice", name: "existing_id", value: property.id, id: "property_#{property.id}",
                        checked: checked,
                        autofocus: !focus_new && checked,
                        title: property.short_address,
                        meta: [property.city, property.post_code].compact_blank.join(", "),
                        tags: (property.involved_party_id == @vendor.id ? tag.span("Their property", class: "badge bg-primary") : tag.span("No vendor yet", class: "badge bg-light")) %>
                <% end %>
              </div>
            </fieldset>
            <div class="sale-option__actions">
              <button type="submit" class="btn btn-outline-primary btn-sm">Continue with this property <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></button>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
    <%= render layout: "sales/step_footer" do %><% end %>
  </div>
</section>
