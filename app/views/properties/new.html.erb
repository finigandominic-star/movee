<div class="container py-4">
  <!-- Breadcrumb Navigation -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item"><%= link_to "Properties", properties_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item active" aria-current="page">New Property</li>
    </ol>
  </nav>

  <div class="row justify-content-center">
    <div class="col-12 col-lg-9 col-xl-8">
      <!-- Card Container -->
      <div class="card border-0 shadow-sm overflow-hidden">
        <!-- Header -->
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
          <div>
            <h1 class="h3 fw-bold text-dark mb-1">
              <i class="fa-solid fa-house-chimney-medical text-primary me-2"></i>New Property Listing
            </h1>
            <p class="text-muted mb-0 small">Enter all relevant address, media, and party information to list a property.</p>
          </div>
          <%= link_to properties_path, class: "btn btn-sm btn-outline-secondary d-none d-sm-inline-flex align-items-center gap-1" do %>
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back</span>
          <% end %>
        </div>

        <div class="card-body p-4">
          <%= render "properties/form", property: @property, submit_label: "Save Property" %>
        </div>
      </div>
    </div>
  </div>
</div>
