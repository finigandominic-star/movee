<div class="container py-4 py-lg-5">
  <div class="card card--property form-shell">
    <div class="card-header">
      <h1 class="h4 mb-1">Add property</h1>
      <p class="text-muted small mb-0">List the address now; assign the vendor and start a transaction next.</p>
    </div>
    <div class="card-body p-4">
      <%# Optional shortcut: read a client PDF and fill in the address below (see ClientDocumentsController) %>
      <%= render "client_documents/fill_from_pdf", document: @client_document, step: "property" %>
      <%= render "properties/form", property: @property, submit_label: "Add property" %>
    </div>
  </div>
</div>
