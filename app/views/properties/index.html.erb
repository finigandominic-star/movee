<div class="container py-4 py-lg-5" data-controller="search-autocomplete" data-action="click@window->search-autocomplete#closeSuggestions">
  <%= render layout: "shared/page_header", locals: { title: "Properties" } do %>
    <%= link_to new_property_path, class: "btn btn-primary" do %>
      <i class="fa-solid fa-plus" aria-hidden="true"></i>
      <span>Add property</span>
    <% end %>
  <% end %>

  <% if @properties.empty? && params[:q].blank? %>
    <%= render layout: "shared/empty_state", locals: { icon: "fa-house-chimney", title: "No properties yet", text: "List your first property, then assign its vendor and start a transaction." } do %>
      <%= link_to new_property_path, class: "btn btn-primary" do %>
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        <span>Add property</span>
      <% end %>
    <% end %>
  <% else %>
    <div class="page-toolbar">
      <%= form_with url: properties_path, method: :get, class: "flex-grow-1", data: { turbo_frame: "_top" } do |f| %>
        <div class="input-group position-relative">
          <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
          <%= f.search_field :q, value: params[:q], placeholder: "Search properties by address, city, or postcode", class: "form-control", aria: { label: "Search properties" }, data: { search_autocomplete_target: "input", action: "input->search-autocomplete#filter focus->search-autocomplete#filter" } %>
          <%= link_to properties_path, class: "btn btn-outline-secondary", hidden: params[:q].blank?, aria: { label: "Clear search" }, data: { search_autocomplete_target: "clear", action: "search-autocomplete#reset" } do %>
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
          <% end %>
          <div class="search-suggestions" hidden data-search-autocomplete-target="suggestions" data-action="click->search-autocomplete#pick"></div>
        </div>
      <% end %>

      <ul class="nav nav-pills small" id="propertyViewTabs" role="tablist" aria-label="Choose list layout">
        <li class="nav-item" role="presentation">
          <button class="nav-link active py-1 px-3" id="cards-tab" data-bs-toggle="pill" data-bs-target="#cards-view" type="button" role="tab" aria-controls="cards-view" aria-selected="true">
            <i class="fa-solid fa-grip me-1" aria-hidden="true"></i>Cards
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link py-1 px-3" id="table-tab" data-bs-toggle="pill" data-bs-target="#table-view" type="button" role="tab" aria-controls="table-view" aria-selected="false">
            <i class="fa-solid fa-table-list me-1" aria-hidden="true"></i>Table
          </button>
        </li>
      </ul>
    </div>

    <% if @properties.empty? %>
      <p class="text-muted">No properties match "<%= params[:q] %>".</p>
    <% else %>

    <div class="tab-content" id="propertyViewTabsContent">
      <div class="tab-pane fade show active" id="cards-view" role="tabpanel" aria-labelledby="cards-tab" tabindex="0">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xxl-4 card-grid">
          <% @properties.each do |property| %>
            <% party = property.involved_party %>
            <% agent = property.user %>
            <div class="col" data-search-autocomplete-target="item" data-name="<%= property.full_address %>">
              <article class="card record-card card--property">
                <% if property.photo.attached? %>
                  <%= image_tag property.photo, class: "record-card__image", alt: property.short_address %>
                <% else %>
                  <div class="record-card__image record-card__image--empty" aria-hidden="true">
                    <i class="fa-solid fa-house"></i>
                  </div>
                <% end %>

                <div class="card-header">
                  <div>
                    <h2 class="record-card__title">
                      <%= link_to property.short_address, property_path(property) %>
                    </h2>
                    <p class="record-card__subtitle"><%= [property.city, property.post_code].compact_blank.join(" · ") %></p>
                  </div>
                  <% if property.sold? %>
                    <span class="badge bg-secondary">Sold</span>
                  <% else %>
                    <span class="badge bg-success">For sale</span>
                  <% end %>
                </div>

                <div class="card-body">
                  <dl class="mb-0 d-flex flex-column gap-2">
                    <div class="record-meta">
                      <dt>Vendor</dt>
                      <dd>
                        <% if party.nil? %>
                          <span class="text-muted fw-normal fst-italic">Not assigned</span>
                        <% elsif policy(property).show_involved_party? %>
                          <%= party.full_name %>
                        <% else %>
                          <span class="badge bg-light"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Protected Client</span>
                        <% end %>
                      </dd>
                    </div>
                    <div class="record-meta">
                      <dt>Agent</dt>
                      <dd>
                        <% if agent %>
                          <%= agent_with_avatar(agent) %>
                        <% else %>
                          —
                        <% end %>
                      </dd>
                    </div>
                    <div class="record-meta">
                      <dt>Transactions</dt>
                      <dd><%= property.transactions.size %></dd>
                    </div>
                  </dl>
                </div>

                <div class="card-footer">
                  <%= link_to "View", property_path(property), class: "btn btn-sm btn-outline-primary" %>
                  <% if policy(property).update? %>
                    <%= link_to icon_label("fa-pen", "Edit #{property.short_address}"), edit_property_path(property), class: "btn btn-sm btn-outline-secondary btn-icon" %>
                  <% end %>
                  <% if policy(property).destroy? %>
                    <%= link_to icon_label("fa-trash-can", "Delete #{property.short_address}"), property_path(property), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this property?" }, class: "btn btn-sm btn-outline-danger btn-icon" %>
                  <% end %>
                </div>
              </article>
            </div>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="table-view" role="tabpanel" aria-labelledby="table-tab" tabindex="0">
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <caption class="visually-hidden">Properties</caption>
            <thead>
              <tr>
                <th scope="col">Address</th>
                <th scope="col">Location</th>
                <th scope="col">Status</th>
                <th scope="col">Vendor</th>
                <th scope="col">Agent</th>
                <th scope="col" class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @properties.each do |property| %>
                <% party = property.involved_party %>
                <% agent = property.user %>
                <tr data-search-autocomplete-target="item" data-name="<%= property.full_address %>">
                  <td>
                    <%= link_to property.short_address, property_path(property), class: "fw-semibold text-decoration-none" %>
                    <% if property.second_line_of_address.present? %>
                      <small class="text-muted d-block"><%= property.second_line_of_address %></small>
                    <% end %>
                  </td>
                  <td><%= [property.city, property.post_code].compact_blank.join(" · ") %></td>
                  <td>
                    <% if property.sold? %>
                      <span class="badge bg-secondary">Sold</span>
                    <% else %>
                      <span class="badge bg-success">For sale</span>
                    <% end %>
                  </td>
                  <td>
                    <% if party.nil? %>
                      <span class="text-muted fst-italic">Not assigned</span>
                    <% elsif policy(property).show_involved_party? %>
                      <%= party.full_name %>
                    <% else %>
                      <span class="badge bg-light"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Protected Client</span>
                    <% end %>
                  </td>
                  <td>
                    <% if agent %>
                      <div class="fw-medium"><%= agent_with_avatar(agent) %></div>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                  <td class="text-end">
                    <div class="d-inline-flex gap-1">
                      <%= link_to icon_label("fa-eye", "View #{property.short_address}"), property_path(property), class: "btn btn-sm btn-outline-primary btn-icon" %>
                      <% if policy(property).update? %>
                        <%= link_to icon_label("fa-pen", "Edit #{property.short_address}"), edit_property_path(property), class: "btn btn-sm btn-outline-secondary btn-icon" %>
                      <% end %>
                      <% if policy(property).destroy? %>
                        <%= link_to icon_label("fa-trash-can", "Delete #{property.short_address}"), property_path(property), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this property?" }, class: "btn btn-sm btn-outline-danger btn-icon" %>
                      <% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <% end %>
  <% end %>
</div>
