<% stages = property_progress_stages(@property) %>
<% current_index = stages.index { |stage| !stage[:done] } %>
<% party = @property.involved_party %>

<!-- Hero Image -->
<% if @property.photos.present? %>
  <div class="property-hero">
    <img src="<%= @property.photos %>" alt="<%= @property.short_address %>">
  </div>
<% else %>
  <div class="property-hero property-hero--empty">
    <i class="fa-solid fa-house-chimney fa-5x"></i>
  </div>
<% end %>

<section class="property-show">
  <div class="container">
    <div class="row g-5">
      <!-- Address, Actions & Progress -->
      <div class="col-12 col-lg-7">
        <div class="d-flex flex-wrap align-items-center gap-3">
          <h1 class="property-show__title"><%= @property.short_address %></h1>

          <% if policy(@property).update? %>
            <%= link_to "Update", edit_property_path(@property), class: "btn property-show__update-btn ms-lg-5" %>
          <% end %>

          <% if policy(@property).destroy? %>
            <%= link_to property_path(@property), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this property?" }, class: "btn btn-sm btn-outline-danger", title: "Delete property" do %>
              <i class="fa-solid fa-trash-can"></i>
            <% end %>
          <% end %>
        </div>

        <p class="text-muted small mt-2 mb-0">
          <i class="fa-solid fa-location-dot me-1"></i><%= @property.full_address %>
          <% if @property.sold? %>
            <span class="badge bg-secondary ms-2">Sold</span>
          <% else %>
            <span class="badge bg-success ms-2">Available</span>
          <% end %>
        </p>

        <h2 class="h6 fw-bold mt-5 mb-0">Progress:</h2>
        <div class="progress-tracker">
          <% stages.each_with_index do |stage, index| %>
            <% state = if stage[:done] then "done" elsif index == current_index then "current" end %>
            <div class="progress-tracker__stage <%= "progress-tracker__stage--#{state}" if state %>">
              <span class="progress-tracker__label" title="<%= stage[:name] %>"><%= stage[:name] %></span>
              <span class="progress-tracker__dot"></span>
              <div class="progress-tracker__bar"></div>
              <% if index == current_index %>
                <div class="progress-tracker__info"><%= stage[:info] %></div>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Transactions & Chains -->
        <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
          <h2 class="h6 fw-bold mb-0">Transactions &amp; Chains:</h2>
          <%= link_to new_transaction_path(property_id: @property.id), class: "btn btn-sm property-show__update-btn" do %>
            <i class="fa-solid fa-plus me-1"></i> Add Transaction
          <% end %>
        </div>

        <% if @property.transactions.any? %>
          <ul class="property-transactions">
            <% @property.transactions.each do |transaction| %>
              <li class="property-transactions__item <%= "property-transactions__item--completed" if transaction.completed? %>">
                <div>
                  <%= link_to "Transaction ##{transaction.id}", transaction_path(transaction), class: "property-transactions__link" %>
                  <span class="property-transactions__meta">
                    <% if transaction.chain %>
                      <%= link_to "Chain ##{transaction.chain.id}", chain_path(transaction.chain) %>
                      · <%= transaction.chain.active? ? "Active" : "Inactive" %> ·
                    <% end %>
                    <%= transaction.created_at.strftime("%d %b %Y") %>
                  </span>
                </div>
                <div class="d-flex align-items-center gap-1">
                  <span class="property-transactions__status"><%= transaction.status_label %></span>
                  <span class="badge <%= transaction.legal_stage_badge_class %>"
                        data-bs-toggle="tooltip"
                        data-bs-placement="top"
                        data-bs-title="<%= transaction.legal_stage_definition[:tooltip] %>">
                    <i class="fa-solid <%= transaction.legal_stage_definition[:icon] %> me-1"></i>
                    <%= transaction.legal_stage_short_title %>
                  </span>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="small text-muted mb-0">No transactions or chain records are currently linked to this property.</p>
        <% end %>
      </div>

      <!-- Side Panel: Client & Agent -->
      <div class="col-12 col-lg-5 d-flex">
        <div class="property-show__panel w-100">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 fw-bold mb-0">Client</h2>
            <% if party %>
              <div>
                <% if party.seller? %><span class="badge bg-primary">Seller</span><% end %>
                <% if party.buyer? %><span class="badge bg-warning text-dark">Buyer</span><% end %>
              </div>
            <% end %>
          </div>

          <% if party %>
            <% if policy(party).show_personal_data? %>
              <p class="fw-semibold mb-1"><%= party.full_name %></p>
              <ul class="list-unstyled small mb-0">
                <% if party.phone.present? %>
                  <li><i class="fa-solid fa-phone me-1 text-muted"></i><a href="tel:<%= party.phone %>" class="text-decoration-none"><%= party.phone %></a></li>
                <% end %>
                <% if party.email.present? %>
                  <li><i class="fa-solid fa-envelope me-1 text-muted"></i><a href="mailto:<%= party.email %>" class="text-decoration-none"><%= party.email %></a></li>
                <% end %>
                <% if party.contact_info.present? %>
                  <li class="mt-1 text-muted"><%= party.contact_info %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="small text-muted mb-0">
                <i class="fa-solid fa-user-shield me-1"></i>
                Confidential client — personal contact details are protected under agent privacy policies.
              </p>
            <% end %>

            <% if policy(@property).update? %>
              <%= button_to remove_involved_party_property_path(@property), method: :delete, data: { turbo_confirm: "Unassign #{party.full_name} from this property?" }, class: "btn btn-sm btn-outline-danger mt-2" do %>
                <i class="fa-solid fa-user-xmark me-1"></i> Remove Client
              <% end %>
            <% end %>
          <% else %>
            <p class="small text-muted mb-2">No involved party assigned yet.</p>
            <% if policy(@property).update? %>
              <%= link_to edit_property_path(@property), class: "btn btn-sm btn-outline-primary" do %>
                <i class="fa-solid fa-user-plus me-1"></i> Assign Client
              <% end %>
            <% end %>
          <% end %>

          <hr>

          <h2 class="h6 fw-bold mb-2">Listed By</h2>
          <% if @property.user %>
            <p class="mb-0 fw-semibold"><%= @property.user.user_name.presence || @property.user.email %></p>
            <% if @property.user.company.present? %>
              <p class="small text-muted mb-0"><i class="fa-solid fa-building me-1"></i><%= @property.user.company %></p>
            <% end %>
            <p class="small text-muted mb-0"><%= @property.user.email %></p>
          <% else %>
            <p class="small text-muted mb-0">No user assigned.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
