<% party = @property.involved_party %>
<% agent = @property.user %>
<%# One prominent workflow step: assign the vendor, then start a transaction %>
<% next_step = if party.nil? && policy(@property).update? then :assign_vendor elsif party && @property.transactions.empty? then :start_transaction end %>
<% status_tag = @property.sold? ? tag.span("Sold", class: "badge bg-secondary ms-1") : tag.span("For sale", class: "badge bg-success ms-1") %>

<!-- Hero Image -->
<% if @property.photo.attached? %>
  <div class="property-hero">
    <%= image_tag @property.photo, alt: @property.short_address %>
  </div>
<% else %>
  <div class="property-hero property-hero--empty" aria-hidden="true">
    <i class="fa-solid fa-house-chimney fa-5x"></i>
  </div>
<% end %>

<div class="container py-4 py-lg-5 property-show">
  <%= render layout: "shared/page_header", locals: { title: @property.short_address, subtitle: safe_join([[@property.second_line_of_address, @property.city, @property.post_code].compact_blank.join(", "), status_tag], " ") } do %>
    <% if next_step == :assign_vendor %>
      <%= link_to edit_property_path(@property), class: "btn btn-accent" do %>
        <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
        <span>Assign vendor</span>
      <% end %>
    <% elsif next_step == :start_transaction %>
      <%= link_to new_transaction_path(property_id: @property.id), class: "btn btn-accent" do %>
        <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        <span>Start transaction</span>
      <% end %>
    <% end %>
    <% if policy(@property).update? %>
      <%= link_to edit_property_path(@property), class: "btn btn-outline-primary" do %>
        <i class="fa-solid fa-pen" aria-hidden="true"></i>
        <span>Edit</span>
      <% end %>
    <% end %>
    <% if policy(@property).destroy? %>
      <%= link_to icon_label("fa-trash-can", "Delete property"), property_path(@property), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this property?" }, class: "btn btn-outline-danger btn-icon" %>
    <% end %>
  <% end %>

  <div class="row g-4">
    <div class="col-12 col-lg-8 d-flex flex-column gap-4">
      <% active_tx = @property.transactions.find_by(completed: false) || @property.transactions.order(created_at: :desc).first %>
      <% tx_current_idx = active_tx ? active_tx.legal_stage_index : 0 %>
      <% tx_percent = active_tx ? active_tx.legal_stage_percentage : 0 %>
      <% tx_timing = active_tx ? active_tx.overall_timing_status : { label: "Pending offer", badge_class: "bg-secondary" } %>
      <section class="card card--property" data-controller="tooltip" aria-labelledby="conveyancing-heading">
        <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
          <div>
            <h2 class="h6 mb-0" id="conveyancing-heading">Conveyancing progress</h2>
            <p class="text-muted small mb-0">England &amp; Wales conveyancing stages</p>
          </div>
          <div class="d-flex align-items-center gap-2 flex-wrap">
            <span class="badge <%= tx_timing[:badge_class] %>">
              <i class="fa-regular fa-clock me-1" aria-hidden="true"></i><%= tx_timing[:label] %>
            </span>
            <span class="badge bg-primary">
              Stage <%= tx_current_idx %> of <%= Transaction::LEGAL_STAGES.size %> (<%= tx_percent %>%)
            </span>
          </div>
        </div>

        <div class="card-body p-3 p-md-4">
          <div class="d-flex justify-content-between text-muted small mb-1 flex-wrap gap-1">
            <span>Offer agreed: <strong><%= active_tx&.transaction_start_date&.strftime("%d %b %Y") || "Pending" %></strong></span>
            <span>Current: <strong><%= active_tx ? active_tx.legal_stage_definition[:short_name] : "Awaiting offer" %></strong></span>
            <span>Target completion: <strong><%= active_tx&.estimated_completion_date&.strftime("%d %b %Y") || "—" %></strong></span>
          </div>
          <div class="progress property-show__progress">
            <div class="progress-bar <%= (active_tx&.completed?) ? 'bg-success' : 'bg-primary' %>"
                 role="progressbar"
                 style="width: <%= tx_percent %>%;"
                 aria-label="Conveyancing progress"
                 aria-valuenow="<%= tx_percent %>"
                 aria-valuemin="0"
                 aria-valuemax="100">
            </div>
          </div>

          <div class="conveyancing-pipeline">
            <div class="conveyancing-pipeline__track">
              <% Transaction::LEGAL_STAGES.each do |stage_key| %>
                <% stage_def = Transaction::LEGAL_STAGE_DEFINITIONS[stage_key] %>
                <% s_idx = stage_def[:index] %>
                <% is_done = active_tx ? (s_idx < tx_current_idx) : false %>
                <% is_current = active_tx ? (s_idx == tx_current_idx) : false %>
                <% step_state = is_done ? "completed" : (is_current ? "current" : "pending") %>
                <% timing = active_tx ? active_tx.stage_timing(stage_key) : { label: "Pending", badge_class: "bg-secondary", full_label: "Awaiting offer agreement" } %>
                <% est_date = timing[:estimated_date] %>
                <% act_date = timing[:actual_date] %>
                <% tooltip_title = "<strong>Stage #{s_idx}: #{ERB::Util.html_escape(stage_def[:name])}</strong><br>" \
                                   "<span class='badge bg-light text-dark my-1'>Lead: #{ERB::Util.html_escape(stage_def[:lead_actor])}</span><br>" \
                                   "#{ERB::Util.html_escape(stage_def[:tooltip])}" %>

                <div class="conveyancing-pipeline__step conveyancing-pipeline__step--<%= step_state %>"
                     data-bs-toggle="tooltip"
                     data-bs-html="true"
                     data-bs-placement="top"
                     data-bs-title="<%= tooltip_title %>">
                  <div class="conveyancing-pipeline__circle">
                    <% if is_done %>
                      <i class="fa-solid fa-check" aria-hidden="true"></i>
                    <% elsif is_current %>
                      <i class="fa-solid <%= stage_def[:icon] %>" aria-hidden="true"></i>
                    <% else %>
                      <span><%= s_idx %></span>
                    <% end %>
                  </div>
                  <span class="conveyancing-pipeline__label"><%= stage_def[:short_name] %></span>
                  <div class="conveyancing-pipeline__timing text-center mt-1">
                    <span class="badge <%= timing[:badge_class] %>"><%= timing[:label] %></span>
                    <% if act_date.present? %>
                      <span class="conveyancing-pipeline__date d-none d-md-block text-muted">Done: <%= act_date.strftime("%d %b") %></span>
                    <% elsif est_date.present? %>
                      <span class="conveyancing-pipeline__date d-none d-md-block text-muted">Est: <%= est_date.strftime("%d %b") %></span>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>
          </div>

          <% if active_tx %>
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 pt-3 border-top">
              <span class="small text-muted">Tracking <%= link_to "Transaction ##{active_tx.id}", transaction_path(active_tx), class: "fw-semibold text-decoration-none" %></span>
              <%= link_to transaction_path(active_tx), class: "btn btn-sm btn-outline-primary" do %>
                <span>Manage stages</span>
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              <% end %>
            </div>
          <% else %>
            <p class="small text-muted mb-0 pt-3 border-top">
              No transaction yet. Start one once an offer is accepted.
            </p>
          <% end %>
        </div>
      </section>

      <section class="card card--property" aria-labelledby="transactions-heading">
        <div class="card-header d-flex justify-content-between align-items-center gap-2">
          <h2 class="h6 mb-0" id="transactions-heading">Transactions &amp; chains</h2>
          <% unless next_step == :start_transaction %>
            <%= link_to new_transaction_path(property_id: @property.id), class: "btn btn-sm btn-outline-secondary" do %>
              <i class="fa-solid fa-plus" aria-hidden="true"></i>
              <span>Add transaction</span>
            <% end %>
          <% end %>
        </div>
        <div class="card-body">
          <% if @property.transactions.any? %>
            <ul class="property-transactions">
              <% @property.transactions.each do |transaction| %>
                <li class="property-transactions__item <%= "property-transactions__item--completed" if transaction.completed? %>">
                  <div>
                    <%= link_to "Transaction ##{transaction.id}", transaction_path(transaction), class: "property-transactions__link" %>
                    <span class="property-transactions__meta">
                      <% if transaction.chain %>
                        <%= link_to chain_name(transaction.chain), chain_path(transaction.chain) %>
                        · Chain #<%= transaction.chain.id %>
                        · <%= transaction.chain.active? ? "Active" : "Inactive" %> ·
                      <% end %>
                      <%= transaction.created_at.strftime("%d %b %Y") %>
                    </span>
                  </div>
                  <div class="d-flex align-items-center gap-1 flex-shrink-0">
                    <span class="property-transactions__status"><%= transaction.status_label %></span>
                    <span class="badge <%= transaction.legal_stage_badge_class %>"
                          data-bs-toggle="tooltip"
                          data-bs-placement="top"
                          data-bs-title="<%= transaction.legal_stage_definition[:tooltip] %>">
                      <i class="fa-solid <%= transaction.legal_stage_definition[:icon] %> me-1" aria-hidden="true"></i><%= transaction.legal_stage_short_title %>
                    </span>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="small text-muted mb-0">This property isn't in a transaction or chain yet.</p>
          <% end %>
        </div>
      </section>
    </div>

    <div class="col-12 col-lg-4 d-flex flex-column gap-4">
      <section class="card card--party" aria-labelledby="vendor-heading">
        <div class="card-header">
          <h2 class="h6 mb-0" id="vendor-heading">Vendor</h2>
        </div>
        <div class="card-body">
          <% if party %>
            <% if policy(@property).show_involved_party? %>
              <p class="fw-semibold mb-1"><%= link_to party.full_name, involved_party_path(party), class: "text-decoration-none" %></p>
              <ul class="list-unstyled small mb-0">
                <% if party.phone.present? %>
                  <li><i class="fa-solid fa-phone me-1 text-muted" aria-hidden="true"></i><a href="tel:<%= party.phone %>" class="text-decoration-none"><%= party.phone %></a></li>
                <% end %>
                <% if party.email.present? %>
                  <li><i class="fa-solid fa-envelope me-1 text-muted" aria-hidden="true"></i><a href="mailto:<%= party.email %>" class="text-decoration-none"><%= party.email %></a></li>
                <% end %>
                <% if party.contact_info.present? %>
                  <li class="mt-1 text-muted"><%= party.contact_info %></li>
                <% end %>
              </ul>
            <% else %>
              <span class="badge bg-light mb-2"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Protected Client</span>
              <p class="small text-muted mb-0">
                Confidential client — personal contact details are protected. Contact the listing agent below.
              </p>
              <% if @property.user %>
                <div class="small text-muted bg-white p-2 rounded border mt-2">
                  <span class="fw-semibold text-dark d-block mb-1">Managing Agent:</span>
                  <div class="d-flex align-items-center gap-2">
                    <%= agent_avatar(@property.user, size: 32) %>
                    <div><%= @property.user.user_name %> <% if @property.user.company.present? %>(<%= @property.user.company %>)<% end %></div>
                  </div>
                  <div class="mt-1">
                    <a href="mailto:<%= @property.user.email %>" class="text-decoration-none d-block"><i class="fa-solid fa-envelope me-1"></i><%= @property.user.email %></a>
                    <% if @property.user.phone.present? %>
                      <a href="tel:<%= @property.user.phone %>" class="text-decoration-none d-block"><i class="fa-solid fa-phone me-1"></i><%= @property.user.phone %></a>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>

            <% if policy(@property).update? %>
              <%= button_to remove_involved_party_property_path(@property), method: :delete, data: { turbo_confirm: "Unassign #{party.full_name} from this property?" }, class: "btn btn-sm btn-outline-danger mt-3" do %>
                <i class="fa-solid fa-user-xmark" aria-hidden="true"></i>
                <span>Remove vendor</span>
              <% end %>
            <% end %>
          <% else %>
            <p class="small text-muted mb-0">No vendor assigned yet.</p>
          <% end %>
        </div>
      </section>

      <section class="card card--property" aria-labelledby="agent-heading">
        <div class="card-header">
          <h2 class="h6 mb-0" id="agent-heading">Listing agent</h2>
        </div>
        <div class="card-body">
          <% if agent %>
            <p class="mb-1"><%= agent_with_avatar(agent, size: 40, name_class: "fw-semibold") %></p>
            <% if agent.company.present? %>
              <p class="small text-muted mb-1"><%= agent.company %></p>
            <% end %>
            <ul class="list-unstyled small mb-0 mt-1">
              <li>
                <a href="mailto:<%= agent.email %>" class="text-decoration-none"><i class="fa-solid fa-envelope me-1" aria-hidden="true"></i><%= agent.email %></a>
              </li>
              <% if agent.phone.present? %>
                <li>
                  <a href="tel:<%= agent.phone %>" class="text-decoration-none"><i class="fa-solid fa-phone me-1" aria-hidden="true"></i><%= agent.phone %></a>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="small text-muted mb-0">No agent assigned.</p>
          <% end %>
        </div>
      </section>
    </div>
  </div>
</div>
