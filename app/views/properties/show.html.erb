<% party = @property.involved_party %>

<!-- Hero Image -->
<% if @property.photos.present? %>
  <div class="property-hero">
    <img src="<%= @property.photos %>" alt="<%= @property.short_address %>">
  </div>
<% else %>
  <div class="property-hero property-hero--empty">
    <i class="fa-solid fa-house-chimney fa-5x"></i>
  </div>
<% end %>

<section class="property-show">
  <div class="container">
    <div class="row g-5">
      <!-- Address, Actions & Progress -->
      <div class="col-12 col-lg-7">
        <div class="d-flex flex-wrap align-items-center gap-3">
          <h1 class="property-show__title"><%= @property.short_address %></h1>

          <% if policy(@property).update? %>
            <%= link_to "Update", edit_property_path(@property), class: "btn property-show__update-btn ms-lg-5" %>
          <% end %>

          <% if policy(@property).destroy? %>
            <%= link_to property_path(@property), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this property?" }, class: "btn btn-sm btn-outline-danger", title: "Delete property" do %>
              <i class="fa-solid fa-trash-can"></i>
            <% end %>
          <% end %>
        </div>

        <p class="text-muted small mt-2 mb-0">
          <i class="fa-solid fa-location-dot me-1"></i><%= @property.full_address %>
          <% if @property.sold? %>
            <span class="badge bg-secondary ms-2">Sold</span>
          <% else %>
            <span class="badge bg-success ms-2">Available</span>
          <% end %>
        </p>

        <% active_tx = @property.transactions.find_by(completed: false) || @property.transactions.order(created_at: :desc).first %>
        <% tx_current_idx = active_tx ? active_tx.legal_stage_index : 0 %>
        <% tx_percent = active_tx ? active_tx.legal_stage_percentage : 0 %>
        <% tx_timing = active_tx ? active_tx.overall_timing_status : { label: "Pending Offer", badge_class: "bg-secondary" } %>
        <div class="card border-0 shadow-sm mt-4 mb-4" data-controller="tooltip">
          <div class="card-header bg-white py-3 border-bottom d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
            <div>
              <h2 class="h6 fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                <i class="fa-solid fa-scale-balanced text-primary"></i>
                <span>Conveyancing Progress</span>
              </h2>
              <p class="text-muted small mb-0 mt-1">
                UK conveyancing stages under England &amp; Wales property law.
              </p>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <span class="badge <%= tx_timing[:badge_class] %> px-2 py-1">
                <i class="fa-regular fa-clock me-1"></i> <%= tx_timing[:label] %>
              </span>
              <span class="badge <%= (active_tx&.completed?) ? 'bg-success' : 'bg-primary' %>-subtle text-<%= (active_tx&.completed?) ? 'success' : 'primary' %> border border-<%= (active_tx&.completed?) ? 'success' : 'primary' %>-subtle px-2 py-1">
                Stage <%= tx_current_idx %> of <%= Transaction::LEGAL_STAGES.size %> (<%= tx_percent %>%)
              </span>
            </div>
          </div>

          <div class="card-body p-3 p-md-4">
            <!-- Overall Progress Bar & Target Dates -->
            <div class="mb-3">
              <div class="d-flex justify-content-between text-muted small mb-1 fw-semibold flex-wrap gap-1">
                <span>
                  <i class="fa-solid fa-handshake me-1 text-secondary"></i> Offer Agreed:
                  <strong><%= active_tx&.transaction_start_date&.strftime("%d %b %Y") || "Pending Offer Acceptance" %></strong>
                </span>
                <span>
                  Current: <strong><%= active_tx ? active_tx.legal_stage_definition[:short_name] : "Awaiting Offer" %></strong> (<%= tx_percent %>%)
                </span>
                <span>
                  <i class="fa-solid fa-key me-1 text-success"></i> Target Completion:
                  <strong><%= active_tx&.estimated_completion_date&.strftime("%d %b %Y") || "—" %></strong>
                </span>
              </div>
              <div class="progress" style="height: 8px;">
                <div class="progress-bar <%= (active_tx&.completed?) ? 'bg-success' : 'bg-primary' %> progress-bar-striped <%= 'progress-bar-animated' unless active_tx&.completed? %>"
                     role="progressbar"
                     style="width: <%= tx_percent %>%;"
                     aria-valuenow="<%= tx_percent %>"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>
              </div>
            </div>

            <!-- Conveyancing Pipeline Stepper (Matching Transaction Show) -->
            <div class="conveyancing-pipeline">
              <div class="conveyancing-pipeline__track">
                <% Transaction::LEGAL_STAGES.each do |stage_key| %>
                  <% stage_def = Transaction::LEGAL_STAGE_DEFINITIONS[stage_key] %>
                  <% s_idx = stage_def[:index] %>
                  <% is_done = active_tx ? (s_idx < tx_current_idx) : false %>
                  <% is_current = active_tx ? (s_idx == tx_current_idx) : false %>
                  <% step_state = is_done ? "completed" : (is_current ? "current" : "pending") %>
                  <% timing = active_tx ? active_tx.stage_timing(stage_key) : { label: "Pending", badge_class: "bg-secondary", full_label: "Awaiting offer agreement" } %>
                  <% est_date = timing[:estimated_date] %>
                  <% act_date = timing[:actual_date] %>
                  <% tooltip_title = "<strong>Stage #{s_idx}: #{ERB::Util.html_escape(stage_def[:name])}</strong><br>" \
                                     "<span class='badge bg-light text-dark my-1'>Lead: #{ERB::Util.html_escape(stage_def[:lead_actor])}</span><br>" \
                                     "#{ERB::Util.html_escape(stage_def[:tooltip])}" %>

                  <div class="conveyancing-pipeline__step conveyancing-pipeline__step--<%= step_state %>"
                       data-bs-toggle="tooltip"
                       data-bs-html="true"
                       data-bs-placement="top"
                       data-bs-title="<%= tooltip_title %>">
                    <div class="conveyancing-pipeline__circle">
                      <% if is_done %>
                        <i class="fa-solid fa-check"></i>
                      <% elsif is_current %>
                        <i class="fa-solid <%= stage_def[:icon] %>"></i>
                      <% else %>
                        <span><%= s_idx %></span>
                      <% end %>
                    </div>
                    <span class="conveyancing-pipeline__label">
                      <%= stage_def[:short_name] %>
                    </span>
                    <div class="conveyancing-pipeline__timing text-center mt-1">
                      <span class="badge <%= timing[:badge_class] %>" style="font-size: 0.65rem;">
                        <%= timing[:label] %>
                      </span>
                      <% if act_date.present? %>
                        <span class="conveyancing-pipeline__date d-none d-md-block text-muted" style="font-size: 0.62rem;">
                          Done: <%= act_date.strftime("%d %b") %>
                        </span>
                      <% elsif est_date.present? %>
                        <span class="conveyancing-pipeline__date d-none d-md-block text-muted" style="font-size: 0.62rem;">
                          Est: <%= est_date.strftime("%d %b") %>
                        </span>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>

            <% if active_tx %>
              <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="small text-muted">
                  Linked to <%= link_to "Transaction ##{active_tx.id}", transaction_path(active_tx), class: "fw-semibold text-decoration-none" %>
                </span>
                <%= link_to transaction_path(active_tx), class: "btn btn-sm btn-outline-primary" do %>
                  <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Manage Stages in Transaction
                <% end %>
              </div>
            <% else %>
              <div class="mt-3 pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                <span class="small text-muted">
                  <i class="fa-solid fa-circle-info me-1 text-primary"></i> No active transaction yet. Add a transaction once an offer is accepted.
                </span>
                <%= link_to new_transaction_path(property_id: @property.id), class: "btn btn-sm btn-primary" do %>
                  <i class="fa-solid fa-plus me-1"></i> Add Transaction
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Transactions & Chains -->
        <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
          <h2 class="h6 fw-bold mb-0">Transactions &amp; Chains:</h2>
          <%= link_to new_transaction_path(property_id: @property.id), class: "btn btn-sm property-show__update-btn" do %>
            <i class="fa-solid fa-plus me-1"></i> Add Transaction
          <% end %>
        </div>

        <% if @property.transactions.any? %>
          <ul class="property-transactions">
            <% @property.transactions.each do |transaction| %>
              <li class="property-transactions__item <%= "property-transactions__item--completed" if transaction.completed? %>">
                <div>
                  <%= link_to "Transaction ##{transaction.id}", transaction_path(transaction), class: "property-transactions__link" %>
                  <span class="property-transactions__meta">
                    <% if transaction.chain %>
                      <%= link_to "Chain ##{transaction.chain.id}", chain_path(transaction.chain) %>
                      · <%= transaction.chain.active? ? "Active" : "Inactive" %> ·
                    <% end %>
                    <%= transaction.created_at.strftime("%d %b %Y") %>
                  </span>
                </div>
                <div class="d-flex align-items-center gap-1">
                  <span class="property-transactions__status"><%= transaction.status_label %></span>
                  <span class="badge <%= transaction.legal_stage_badge_class %>"
                        data-bs-toggle="tooltip"
                        data-bs-placement="top"
                        data-bs-title="<%= transaction.legal_stage_definition[:tooltip] %>">
                    <i class="fa-solid <%= transaction.legal_stage_definition[:icon] %> me-1"></i>
                    <%= transaction.legal_stage_short_title %>
                  </span>
                </div>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="small text-muted mb-0">No transactions or chain records are currently linked to this property.</p>
        <% end %>
      </div>

      <!-- Side Panel: Client & Agent -->
      <div class="col-12 col-lg-5 d-flex">
        <div class="property-show__panel w-100">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h6 fw-bold mb-0">Client</h2>
          </div>

          <% if party %>
            <% if policy(party).show_personal_data? %>
              <p class="fw-semibold mb-1"><%= party.full_name %></p>
              <ul class="list-unstyled small mb-0">
                <% if party.phone.present? %>
                  <li><i class="fa-solid fa-phone me-1 text-muted"></i><a href="tel:<%= party.phone %>" class="text-decoration-none"><%= party.phone %></a></li>
                <% end %>
                <% if party.email.present? %>
                  <li><i class="fa-solid fa-envelope me-1 text-muted"></i><a href="mailto:<%= party.email %>" class="text-decoration-none"><%= party.email %></a></li>
                <% end %>
                <% if party.contact_info.present? %>
                  <li class="mt-1 text-muted"><%= party.contact_info %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="small text-muted mb-1">
                <i class="fa-solid fa-user-shield me-1"></i>
                Confidential client — personal contact details are protected under agent privacy policies.
              </p>
              <% if @property.user %>
                <div class="small text-muted bg-white p-2 rounded border mt-2">
                  <span class="fw-semibold text-dark d-block mb-1">Managing Agent:</span>
                  <div><%= @property.user.user_name %> <% if @property.user.company.present? %>(<%= @property.user.company %>)<% end %></div>
                  <div class="mt-1">
                    <a href="mailto:<%= @property.user.email %>" class="text-decoration-none d-block"><i class="fa-solid fa-envelope me-1"></i><%= @property.user.email %></a>
                    <% if @property.user.phone.present? %>
                      <a href="tel:<%= @property.user.phone %>" class="text-decoration-none d-block"><i class="fa-solid fa-phone me-1"></i><%= @property.user.phone %></a>
                    <% end %>
                  </div>
                </div>
              <% end %>
            <% end %>

            <% if policy(@property).update? %>
              <%= button_to remove_involved_party_property_path(@property), method: :delete, data: { turbo_confirm: "Unassign #{party.full_name} from this property?" }, class: "btn btn-sm btn-outline-danger mt-2" do %>
                <i class="fa-solid fa-user-xmark me-1"></i> Remove Client
              <% end %>
            <% end %>
          <% else %>
            <p class="small text-muted mb-2">No involved party assigned yet.</p>
            <% if policy(@property).update? %>
              <%= link_to edit_property_path(@property), class: "btn btn-sm btn-outline-primary" do %>
                <i class="fa-solid fa-user-plus me-1"></i> Assign Client
              <% end %>
            <% end %>
          <% end %>

          <hr>

          <h2 class="h6 fw-bold mb-2">Listed By</h2>
          <% if @property.user %>
            <p class="mb-0 fw-semibold"><%= @property.user.user_name.presence || @property.user.email %></p>
            <% if @property.user.company.present? %>
              <p class="small text-muted mb-1"><i class="fa-solid fa-building me-1"></i><%= @property.user.company %></p>
            <% end %>
            <ul class="list-unstyled small mb-0 mt-1">
              <li>
                <a href="mailto:<%= @property.user.email %>" class="text-decoration-none"><i class="fa-solid fa-envelope me-1 text-muted"></i><%= @property.user.email %></a>
              </li>
              <% if @property.user.phone.present? %>
                <li>
                  <a href="tel:<%= @property.user.phone %>" class="text-decoration-none"><i class="fa-solid fa-phone me-1 text-muted"></i><%= @property.user.phone %></a>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="small text-muted mb-0">No user assigned.</p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>
