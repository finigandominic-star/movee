<div class="container py-4 py-lg-5">
  <div class="card card--property form-shell">
    <div class="card-header">
      <h1 class="h4 mb-1">Edit property</h1>
      <p class="text-muted small mb-0"><%= @property.full_address %></p>
    </div>
    <div class="card-body p-4">
      <%= render "properties/form", property: @property, submit_label: "Save changes" %>
    </div>
  </div>
</div>
