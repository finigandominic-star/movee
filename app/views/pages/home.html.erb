<div class="container py-5 min-vh-100 d-flex flex-column justify-content-between">
  <div>
    <% if user_signed_in? %>
      <!-- Logged-in Dashboard View -->
      <div class="row align-items-center mb-5">
        <div class="col">
          <h1 class="display-6 fw-bold text-dark">Welcome back, <%= current_user.user_name.presence || current_user.email %>!</h1>
          <p class="text-muted">Manage your properties, live transactions, and chains from one place.</p>
        </div>
      </div>

      <div class="row g-4">
        <div class="col-md-4">
          <div class="card shadow-sm h-100 border-0 p-3">
            <div class="card-body">
              <h5 class="fw-bold text-dark mb-2">Properties</h5>
              <p class="text-muted small mb-4">Manage real estate listings and details.</p>
              <%= link_to "View Properties", properties_path, class: "btn btn-dark btn-sm w-100" %>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card shadow-sm h-100 border-0 p-3">
            <div class="card-body">
              <h5 class="fw-bold text-dark mb-2">Transactions</h5>
              <p class="text-muted small mb-4">Track stages, updates, and milestones.</p>
              <%= link_to "View Transactions", transactions_path, class: "btn btn-dark btn-sm w-100" %>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card shadow-sm h-100 border-0 p-3">
            <div class="card-body">
              <h5 class="fw-bold text-dark mb-2">Chains</h5>
              <p class="text-muted small mb-4">Connect properties and manage chains.</p>
              <%= link_to "View Chains", chains_path, class: "btn btn-dark btn-sm w-100" %>
            </div>
          </div>
        </div>
      </div>

    <% else %>
      <!-- Figma Landing Page Layout Matching -->
      <div class="row align-items-center my-5 py-4">
        <!-- Left Column: Title, Subheading, and Action Buttons -->
        <div class="col-lg-5 mb-5 mb-lg-0">
          <h1 class="display-4 fw-bold text-dark mb-2 tracking-tight">
            <span class="text-primary">Moveee</span>
          </h1>
          <h2 class="h4 fw-semibold text-secondary mb-3">Move in like a breeze</h2>
          <p class="text-muted fs-5 mb-4 lh-base">
            Streamline property chains, track live transaction milestones, and coordinate real estate workflows effortlessly in one collaborative hub.
          </p>
          <div class="d-flex align-items-center gap-3">
            <%= link_to "Login", new_user_session_path, class: "btn btn-primary px-4 py-2 fw-semibold shadow-sm" %>
            <a href="#how-it-works" class="text-decoration-none text-dark fw-semibold d-inline-flex align-items-center gap-2">
              <span class="rounded-circle border border-dark p-2 d-inline-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                <i class="fa-solid fa-play fa-xs"></i>
              </span>
              <span>How it works</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Multi-Card Overlapping Mockup matching Figma -->
        <div class="col-lg-7 position-relative">
          <div class="position-relative" style="min-height: 440px;">

            <!-- Card 1: Property Overview with House Image (Top Right) -->
            <div class="position-absolute top-0 end-0 bg-white rounded-4 shadow-lg p-3 border w-75 z-2">
              <div class="mb-3 overflow-hidden rounded-3" style="max-height: 140px;">
                <img src="https://media.istockphoto.com/id/2175973016/photo/modern-luxury-home-exterior-at-sunset.jpg?s=612x612&w=0&k=20&c=6D40lfnRxmyM3kW3BOIK45fEA7K2p9uvOOcCTufwJvw=" alt="Modern House Exterior" class="w-100 object-fit-cover" style="height: 130px;" />
              </div>
              <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                <span class="fw-bold text-dark small">123 Maple Street</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle font-monospace" style="font-size: 10px;">Active</span>
              </div>
              <p class="text-muted mb-2" style="font-size: 11px;"><i class="fa-solid fa-location-dot me-1 text-danger"></i> Lisbon, Portugal</p>
              <div class="d-flex gap-3 text-muted" style="font-size: 10px;">
                <span><i class="fa-solid fa-bed me-1"></i> 3 bedrooms</span>
                <span><i class="fa-solid fa-bath me-1"></i> 2 bathrooms</span>
              </div>
            </div>

            <!-- Card 2: Transaction Timeline (Bottom Left Overlay) -->
            <div class="position-absolute top-50 start-0 translate-middle-y bg-white rounded-4 shadow-lg p-3 border w-50 z-3">
              <div class="fw-bold text-dark mb-2 small"><i class="fa-solid fa-timeline me-1 text-primary"></i> Transaction timeline</div>
              <div class="space-y-1 text-muted" style="font-size: 10px;">
                <div class="py-1 border-bottom d-flex justify-content-between">
                  <span>Listing created</span>
                  <span class="text-success fw-bold">✓</span>
                </div>
                <div class="py-1 border-bottom d-flex justify-content-between">
                  <span>Property shown</span>
                  <span class="text-success fw-bold">✓</span>
                </div>
                <div class="py-1 d-flex justify-content-between">
                  <span>Under contract</span>
                  <span class="text-primary fw-bold">●</span>
                </div>
              </div>
            </div>

            <!-- Card 3: Transaction Details & Fees (Bottom Right) -->
            <div class="position-absolute bottom-0 end-0 bg-white rounded-4 shadow-lg p-3 border w-50 z-1">
              <div class="fw-bold text-dark mb-2 small"><i class="fa-solid fa-file-invoice me-1 text-secondary"></i> Transaction details</div>
              <div class="d-flex justify-content-between text-muted mb-1" style="font-size: 10px;">
                <span>Sale price</span>
                <span class="fw-semibold text-dark">€450,000</span>
              </div>
              <div class="d-flex justify-content-between text-muted mb-2 pb-2 border-bottom" style="font-size: 10px;">
                <span>Agency fee (5%)</span>
                <span class="fw-semibold text-dark">€22,500</span>
              </div>
              <div class="d-flex justify-content-between text-dark fw-bold" style="font-size: 11px;">
                <span>Total</span>
                <span>€472,500</span>
              </div>
            </div>

          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Footer pinned neatly to the bottom -->
  <footer class="pt-4 mt-5 border-top d-flex flex-column flex-sm-row justify-content-between align-items-center text-muted small">
    <div class="mb-3 mb-sm-0">
      <span class="fw-bold text-dark">Moveee</span>
    </div>
    <div class="d-flex gap-4">
      <a href="#" class="text-decoration-none text-muted">Privacy Policy</a>
      <a href="#" class="text-decoration-none text-muted">About Us</a>
      <a href="#" class="text-decoration-none text-muted">Frequently Asked Questions</a>
      <a href="#" class="text-decoration-none text-muted">Cookie Policy</a>
      <a href="#" class="text-decoration-none text-muted">Terms of Use</a>
    </div>
    <div class="d-flex gap-3 mt-3 mt-sm-0">
      <a href="#" class="text-muted"><i class="fa-brands fa-facebook-f"></i></a>
      <a href="#" class="text-muted"><i class="fa-brands fa-linkedin-in"></i></a>
      <a href="#" class="text-muted"><i class="fa-brands fa-youtube"></i></a>
      <a href="#" class="text-muted"><i class="fa-brands fa-instagram"></i></a>
    </div>
  </footer>
</div>
