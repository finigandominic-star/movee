<%# Structured data so search engines understand what Moveee is %>
<% content_for :head do %>
  <script type="application/ld+json">
    <%= raw({
      "@context" => "https://schema.org",
      "@type" => "SoftwareApplication",
      "name" => "Moveee",
      "applicationCategory" => "BusinessApplication",
      "operatingSystem" => "Web",
      "url" => root_url,
      "description" => "Moveee gives UK estate agents full visibility of every property chain, flags blind spots early and helps drive sales from offer to completion.",
      "audience" => { "@type" => "BusinessAudience", "audienceType" => "UK estate agents" }
    }.to_json) %>
  </script>
<% end %>

<%# Hero: lead with the problem, then the promise %>
<section class="landing-hero">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-7">
        <h1 class="landing-hero__title">
          <span class="landing-hero__stat landing-hero__stat--white">In the UK</span>
          <span class="landing-hero__stat">1 in 3</span>
          property sales never make it to completion.
        </h1>
        <p class="landing-hero__lead">
          Meet <strong class="landing-hero__brand">Moveee</strong> &mdash; an app designed to give agents full visibility,
          eliminate blind spots, and drive transactions across the line.
        </p>
        <div class="d-flex flex-wrap align-items-center gap-3">
          <%= link_to new_user_registration_path, class: "btn btn-accent btn-lg" do %>
            Get started free <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          <% end %>
          <%= link_to "Log in", new_user_session_path, class: "btn btn-outline-light btn-lg" %>
        </div>
      </div>

      <%# Visual: the app's own chain cards (as on chains#show), with one link falling behind %>
      <div class="col-lg-5">
        <div class="card card--chain landing-preview" aria-hidden="true">
          <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold">Elm Road chain</span>
            <span class="badge bg-warning status-pill">Open</span>
          </div>
          <div class="card-body p-3">
            <div class="small fw-semibold text-dark mb-2">3 links · 1 completed · 2 in progress</div>
            <div class="progress chain-progress mb-3">
              <div class="progress-bar" style="width: 33%"></div>
            </div>

            <ol class="landing-preview__links list-unstyled mb-0">
              <% [
                   ["Link 1 · Start", "14 Elm Road", "Leeds, LS2 2BB", "Completed", "bg-success", "fa-key", "Completion", "On target", nil],
                   ["Link 2", "3 Birch Close", "Leeds, LS4 4DD", "In progress", "bg-warning", "fa-magnifying-glass-chart", "Searches & Enquiries", "+19d behind", "is-late"],
                   ["Link 3 · End", "8 Station Street", "York, YO1 6GA", "In progress", "bg-warning", "fa-scale-balanced", "Solicitors Instructed", "12d left", nil]
                 ].each do |label, address, place, status, badge, icon, stage, timing, state| %>
                <li class="mini-card <%= state %>">
                  <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                    <span class="mini-card__label"><%= label %></span>
                    <span class="badge <%= badge %>"><%= status %></span>
                  </div>
                  <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="rounded bg-light text-secondary d-flex align-items-center justify-content-center flex-shrink-0" style="width: 40px; height: 40px;">
                      <i class="fa-solid fa-house opacity-50"></i>
                    </div>
                    <div>
                      <div class="mini-card__title"><%= address %></div>
                      <div class="small text-muted"><%= place %></div>
                    </div>
                  </div>
                  <div class="small">
                    <i class="fa-solid <%= icon %> text-primary me-1"></i>
                    <strong><%= stage %></strong>
                    <span class="landing-preview__timing">· <%= timing %></span>
                  </div>
                </li>
              <% end %>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
