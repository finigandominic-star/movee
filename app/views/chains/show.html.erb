<% ordered_txs = @chain.ordered_transactions %>
<% completed_count = ordered_txs.count(&:completed?) %>
<% status_pill = @chain.chain_completed? ? tag.span("Completed", class: "badge bg-success status-pill") : tag.span("Open", class: "badge status-pill status-open") %>

<div class="container-fluid px-3 px-lg-5 py-4 py-lg-5">
  <div class="page-wide">
    <% rename = render("chains/rename", chain: @chain) if policy(@chain).update? %>
    <%= render layout: "shared/page_header", locals: { title: chain_name(@chain), title_badge: status_pill, after_title: rename } do %>
      <% if policy(@chain).update? %>
        <button type="button" class="btn btn-accent" data-bs-toggle="modal" data-bs-target="#connectPropertyModal">
          <i class="fa-solid fa-house-circle-check" aria-hidden="true"></i> Connect property
        </button>
      <% end %>
      <% if policy(@chain).destroy? %>
        <%= link_to chain_path(@chain), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete Chain ##{@chain.id}?" }, class: "btn btn-outline-danger btn-icon", aria: { label: "Delete chain" } do %>
          <i class="fa-solid fa-trash-can" aria-hidden="true"></i>
        <% end %>
      <% end %>
    <% end %>

    <section class="card card--chain mb-4 mb-lg-5" aria-labelledby="chainBoundaryTitle">
      <div class="card-header py-3">
        <h5 class="mb-1" id="chainBoundaryTitle">Chain Boundary Analysis</h5>
      </div>
      <div class="card-body p-3 p-lg-4">
        <div class="chain-ends">
          <% start_info = @chain.start_node_status %>
          <div class="chain-end <%= 'is-closed' if start_info[:closed] %>">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <span class="chain-end__label">
                <i class="fa-solid fa-arrow-down-short-wide me-1" aria-hidden="true"></i> Start of Chain (bottom)
              </span>
              <span class="badge <%= start_info[:closed] ? 'bg-success' : 'status-open' %>"><%= start_info[:label] %></span>
            </div>
            <h6><%= start_info[:party_name] %></h6>
            <% if !start_info[:closed] && policy(@chain).update? %>
              <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#connectPropertyModal" data-position="bottom">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Find buyer's property being sold
              </button>
            <% end %>
          </div>

          <div class="chain-ends__middle">
            <div>
              <div class="mb-2">
                <%= pluralize(ordered_txs.size, "link") %> · <%= completed_count %> completed · <%= ordered_txs.size - completed_count %> in progress
              </div>
              <div class="progress chain-progress" role="progressbar" aria-label="Completed links" aria-valuenow="<%= completed_count %>" aria-valuemin="0" aria-valuemax="<%= ordered_txs.size %>">
                <div class="progress-bar" style="width: <%= ordered_txs.any? ? (completed_count * 100.0 / ordered_txs.size).round : 0 %>%"></div>
              </div>
            </div>
          </div>

          <% end_info = @chain.end_node_status %>
          <div class="chain-end <%= 'is-closed' if end_info[:closed] %>">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
              <span class="chain-end__label">
                <i class="fa-solid fa-arrow-up-wide-short me-1" aria-hidden="true"></i> End of Chain (top)
              </span>
              <span class="badge <%= end_info[:closed] ? 'bg-success' : 'status-open' %>"><%= end_info[:label] %></span>
            </div>
            <h6><%= end_info[:party_name] %></h6>
            <% if !end_info[:closed] && policy(@chain).update? %>
              <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#connectPropertyModal" data-position="top">
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i> Find vendor's onward property
              </button>
            <% end %>
          </div>
        </div>

        <% if @chain.both_ends_closed? %>
          <p class="small text-muted mt-3 mb-0">
            <% if @chain.chain_completed? %>
              <i class="fa-solid fa-circle-check text-success me-1" aria-hidden="true"></i>
              <strong>Chain fully completed:</strong> both ends are closed and every transaction in the chain has completed.
            <% else %>
              <i class="fa-solid fa-circle-info text-info me-1" aria-hidden="true"></i>
              <strong>Both ends closed:</strong> the chain stays open while conveyancing proceeds on <%= pluralize(@chain.transactions.pending.size, "transaction") %>.
            <% end %>
          </p>
        <% end %>
      </div>
    </section>

    <section aria-labelledby="chainLinksTitle">
      <div class="page-toolbar">
        <h2 class="h4 fw-bold mb-0" id="chainLinksTitle">Links in this chain</h2>
      </div>

      <% if ordered_txs.empty? %>
        <%= render layout: "shared/empty_state", locals: { icon: "fa-link-slash", title: "No transactions yet", text: "Add a transaction or connect a property to start building this chain." } do %>
          <%= link_to new_transaction_path(chain_id: @chain.id), class: "btn btn-primary" do %>
            <i class="fa-solid fa-plus" aria-hidden="true"></i> Add first transaction
          <% end %>
        <% end %>
      <% else %>
        <ol class="mini-card-row chain-links list-unstyled mb-0">
          <% unless @chain.first_time_buyer_at_start? %>
            <%= render "chains/add_link_card", label: "Add transaction to the start of this chain" %>
          <% end %>
          <% ordered_txs.each_with_index do |tx, idx| %>
            <% agent = tx.creator_or_listing_user %>
            <li class="mini-card">
              <div class="d-flex justify-content-between align-items-center gap-2">
                <span class="mini-card__label">
                  Link <%= idx + 1 %><%= " · Start" if idx.zero? && ordered_txs.size > 1 %><%= " · End" if idx == ordered_txs.size - 1 && ordered_txs.size > 1 %>
                </span>
                <span class="badge <%= tx.completed? ? 'bg-success' : 'bg-warning' %>"><%= tx.status_label %></span>
              </div>

              <div class="d-flex align-items-start gap-2">
                <% if tx.property %>
                  <%= link_to property_thumbnail(tx.property), property_path(tx.property), tabindex: -1, aria: { hidden: true } %>
                <% end %>
                <div class="text-break">
                  <h3 class="mini-card__title">
                    <% if tx.property %>
                      <%= link_to tx.property.short_address, property_path(tx.property) %>
                    <% else %>
                      <span class="text-muted fst-italic">No property assigned</span>
                    <% end %>
                  </h3>
                  <% if tx.property %>
                    <div class="small text-muted">
                      <%= [tx.property.city, tx.property.post_code].compact_blank.join(", ") %><%= " · Sold" if tx.property.sold? %>
                    </div>
                  <% end %>
                </div>
              </div>

              <div class="small" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="<%= tx.legal_stage_definition[:tooltip] %>">
                <i class="fa-solid <%= tx.legal_stage_definition[:icon] %> text-primary me-1" aria-hidden="true"></i>
                <strong><%= tx.legal_stage_short_title %></strong>
                <span class="text-muted">· <%= tx.overall_timing_status[:label] %></span>
              </div>

              <div>
                <div class="mini-card__label mb-1">Managing agent</div>
                <% if agent %>
                  <div class="d-flex align-items-center gap-2">
                    <%= agent_avatar(agent, size: 28) %>
                    <h6><%= agent_link(agent, class: "text-decoration-none text-reset") %></h6>
                  </div>
                  <% if agent.company.present? %>
                    <div class="small text-muted"><i class="fa-solid fa-building me-1" aria-hidden="true"></i><%= agent.company %></div>
                  <% end %>
                <% else %>
                  <span class="text-muted fst-italic small">Unassigned agent</span>
                <% end %>
              </div>

              <div>
                <div class="mini-card__label mb-1">Buyer</div>
                <% if tx.involved_party %>
                  <% if policy(tx.involved_party).show_personal_data? %>
                    <h6><%= link_to tx.involved_party.full_name, involved_party_path(tx.involved_party), class: "text-decoration-none text-reset" %></h6>
                  <% else %>
                    <div class="client-confidential">
                      <i class="fa-solid fa-user-shield me-1" aria-hidden="true"></i>
                      <span class="fw-semibold">Client Confidential</span>
                      <div class="small">Coordinate via <strong><%= agent ? agent_link(agent) : "the managing agent" %></strong>.</div>
                    </div>
                  <% end %>
                <% else %>
                  <span class="text-muted fst-italic small">No buyer assigned</span>
                <% end %>
              </div>

              <div class="chain-link__footer">
                <%= link_to transaction_path(tx), class: "btn btn-sm btn-outline-primary" do %>
                  View transaction
                <% end %>
                <% if policy(tx).update? %>
                  <%= link_to edit_transaction_path(tx), class: "btn btn-sm btn-outline-secondary btn-icon", aria: { label: "Edit transaction ##{tx.id}" } do %>
                    <i class="fa-solid fa-pen" aria-hidden="true"></i>
                  <% end %>
                <% end %>
              </div>
            </li>
          <% end %>
          <% unless @chain.leaving_market_at_end? %>
            <%= render "chains/add_link_card", label: "Add transaction to the end of this chain" %>
          <% end %>
        </ol>
      <% end %>
    </section>
  </div>
</div>

<% if policy(@chain).update? %>
  <div class="modal fade" id="connectPropertyModal" tabindex="-1" aria-labelledby="connectPropertyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content border-0">
        <div class="modal-header">
          <div>
            <h2 class="modal-title h5 fw-bold" id="connectPropertyModalLabel">Connect property to chain</h2>
            <p class="text-muted small mb-0">Pick the property being bought or sold; chains are connected or merged automatically.</p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= form_with url: connect_property_chain_path(@chain), method: :post, local: true do |f| %>
          <div class="modal-body p-4">
            <div class="alert alert-info py-2 small mb-4">
              <i class="fa-solid fa-circle-info me-1" aria-hidden="true"></i>
              <strong>Automatic chain linking:</strong> you only need to select the property. If it is already part of another chain, Moveee merges both chains under the <strong>lowest ID</strong>.
            </div>

            <fieldset class="mb-4">
              <legend class="form-label fs-6">Position in chain</legend>
              <div class="row g-2">
                <div class="col-md-6">
                  <div class="form-check p-3 border rounded">
                    <input class="form-check-input ms-0 me-2" type="radio" name="position" id="posTop" value="top" checked>
                    <label class="form-check-label fw-semibold" for="posTop">
                      <i class="fa-solid fa-arrow-up-wide-short text-primary me-1" aria-hidden="true"></i> Top of chain (onward purchase)
                    </label>
                    <div class="text-muted small mt-1">
                      End vendor <%= @chain.end_transaction&.property&.involved_party&.full_name || 'at top' %> is buying this property.
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="form-check p-3 border rounded">
                    <input class="form-check-input ms-0 me-2" type="radio" name="position" id="posBottom" value="bottom">
                    <label class="form-check-label fw-semibold" for="posBottom">
                      <i class="fa-solid fa-arrow-down-short-wide text-primary me-1" aria-hidden="true"></i> Bottom of chain (downward sale)
                    </label>
                    <div class="text-muted small mt-1">
                      Bottom purchaser <%= @chain.start_transaction&.involved_party&.full_name || 'at bottom' %> is selling this property.
                    </div>
                  </div>
                </div>
              </div>
            </fieldset>

            <div class="mb-3">
              <label for="propertySearchSelect" class="form-label">
                Property <span class="text-danger">*</span>
              </label>
              <% if @connectable_properties.present? && @connectable_properties.any? %>
                <select name="property_id" id="propertySearchSelect" class="form-select form-select-lg" required>
                  <option value="">Choose a property to connect</option>
                  <% @connectable_properties.each do |p| %>
                    <% other_c = p.chains.where.not(id: @chain.id).first || p.transactions.where.not(chain_id: @chain.id).first&.chain %>
                    <option value="<%= p.id %>">
                      <%= p.short_address %>, <%= p.city %> (<%= p.post_code %>)
                      <% if other_c %>
                        — [In Chain #<%= other_c.id %> - will merge under Chain #<%= [@chain.id, other_c.id].min %>]
                      <% elsif p.sold? %>
                        — [Sold listing]
                      <% else %>
                        — [Active listing - Agent: <%= p.user.user_name %>]
                      <% end %>
                    </option>
                  <% end %>
                </select>
                <div class="form-text">Listed by address, city, postcode and managing agent.</div>
              <% else %>
                <div class="alert alert-warning mb-0 small">
                  <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i> No other properties are available to connect. <%= link_to "Add a property", new_property_path, class: "alert-link" %> first.
                </div>
              <% end %>
            </div>
          </div>

          <div class="modal-footer">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <% if @connectable_properties.present? && @connectable_properties.any? %>
              <%= f.submit "Connect property", class: "btn btn-primary" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('connectPropertyModal');
      if (modal) {
        modal.addEventListener('show.bs.modal', function(event) {
          const button = event.relatedTarget;
          if (button && button.dataset.position) {
            const radio = document.getElementById(button.dataset.position === 'bottom' ? 'posBottom' : 'posTop');
            if (radio) radio.checked = true;
          }
        });
      }
    });
  </script>
<% end %>
