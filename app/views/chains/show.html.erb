<div class="container py-4">
  <!-- Breadcrumb Navigation -->
  <nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
      <li class="breadcrumb-item"><%= link_to "Home", root_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item"><%= link_to "Chains", chains_path, class: "text-decoration-none" %></li>
      <li class="breadcrumb-item active" aria-current="page">Chain #<%= @chain.id %></li>
    </ol>
  </nav>

  <!-- Page Header & Action Bar -->
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4 pb-3 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 mb-1">
        <h1 class="h2 fw-bold text-dark mb-0">Chain #<%= @chain.id %></h1>
        <% if @chain.chain_completed? %>
          <span class="badge bg-success fs-6">
            <i class="fa-solid fa-circle-check me-1"></i> Completed Chain
          </span>
        <% else %>
          <span class="badge bg-primary fs-6">
            <i class="fa-solid fa-link me-1"></i> Open Chain (<%= @chain.both_ends_closed? ? "In Progress" : "Ends Open" %>)
          </span>
        <% end %>
      </div>
      <p class="text-muted mb-0 small">
        Created on <%= @chain.created_at&.strftime("%B %d, %Y") || "Recently" %>
        <% if @chain.user %>
          • Initiated by <strong><%= @chain.user.user_name %></strong>
          <% if @chain.user.company.present? %>
            (<%= @chain.user.company %>)
          <% end %>
        <% end %>
      </p>
    </div>

    <!-- Actions -->
    <div class="d-flex gap-2 flex-wrap">
      <%= link_to chains_path, class: "btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" do %>
        <i class="fa-solid fa-arrow-left"></i>
        <span>Back to Chains</span>
      <% end %>

      <% if policy(@chain).update? %>
        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#connectPropertyModal">
          <i class="fa-solid fa-house-circle-check"></i>
          <span>Connect Property</span>
        </button>

        <%= link_to edit_chain_path(@chain), class: "btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm" do %>
          <i class="fa-solid fa-pen"></i>
          <span>Edit</span>
        <% end %>
      <% end %>

      <% if policy(@chain).destroy? %>
        <%= link_to chain_path(@chain), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete Chain ##{@chain.id}?" }, class: "btn btn-outline-danger d-inline-flex align-items-center shadow-sm", title: "Delete Chain" do %>
          <i class="fa-solid fa-trash-can"></i>
        <% end %>
      <% end %>
    </div>
  </div>

  <!-- Summary Stats -->
  <div class="row g-3 mb-4">
    <div class="col-12 col-sm-3">
      <div class="card border-0 shadow-sm p-3 h-100">
        <span class="text-muted small text-uppercase fw-semibold d-block">Total Links</span>
        <span class="fs-4 fw-bold text-dark"><%= pluralize(@chain.transactions.size, "transaction") %></span>
      </div>
    </div>
    <div class="col-12 col-sm-3">
      <div class="card border-0 shadow-sm p-3 h-100">
        <span class="text-muted small text-uppercase fw-semibold d-block">Completed Links</span>
        <span class="fs-4 fw-bold text-success"><%= @chain.transactions.completed.size %></span>
      </div>
    </div>
    <div class="col-12 col-sm-3">
      <div class="card border-0 shadow-sm p-3 h-100">
        <span class="text-muted small text-uppercase fw-semibold d-block">In Progress Links</span>
        <span class="fs-4 fw-bold text-warning-emphasis"><%= @chain.transactions.pending.size %></span>
      </div>
    </div>
    <div class="col-12 col-sm-3">
      <div class="card border-0 shadow-sm p-3 h-100">
        <span class="text-muted small text-uppercase fw-semibold d-block">Overall State</span>
        <span class="fs-5 fw-bold <%= @chain.chain_completed? ? 'text-success' : 'text-primary' %>">
          <%= @chain.chain_completed? ? "Completed" : "Open" %>
        </span>
      </div>
    </div>
  </div>

  <!-- Chain Boundaries (Start & End Rules for UK Property Chains) -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h5 class="card-title fw-bold text-dark mb-0">
          <i class="fa-solid fa-arrows-left-right text-primary me-2"></i> Chain Boundary Analysis
        </h5>
        <p class="text-muted small mb-0 mt-1">
          A chain is open until both ends are closed (First-Time Buyer at bottom, vendor leaving property market at top) and all transactions are completed.
        </p>
      </div>
    </div>
    <div class="card-body p-4">
      <div class="row g-3">
        <!-- Start Boundary (Bottom) -->
        <div class="col-12 col-md-6">
          <% start_info = @chain.start_node_status %>
          <div class="border rounded p-3 h-100 <%= start_info[:closed] ? 'bg-success bg-opacity-10 border-success' : 'bg-warning bg-opacity-10 border-warning' %> d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-uppercase fw-bold text-secondary">
                  <i class="fa-solid fa-arrow-down-short-wide me-1"></i> Start of Chain (Bottom)
                </span>
                <span class="badge <%= start_info[:badge_class] %>"><%= start_info[:label] %></span>
              </div>
              <h6 class="fw-bold text-dark mb-1">
                <%= start_info[:party_name] %>
              </h6>
              <p class="small text-muted mb-2">
                <%= start_info[:description] %>
              </p>
            </div>
            <% unless start_info[:closed] || policy(@chain).update? == false %>
              <div class="pt-2 border-top">
                <button type="button" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#connectPropertyModal" data-position="bottom">
                  <i class="fa-solid fa-magnifying-glass"></i>
                  <span>Find Buyer's Property Being Sold</span>
                </button>
              </div>
            <% end %>
          </div>
        </div>

        <!-- End Boundary (Top) -->
        <div class="col-12 col-md-6">
          <% end_info = @chain.end_node_status %>
          <div class="border rounded p-3 h-100 <%= end_info[:closed] ? 'bg-success bg-opacity-10 border-success' : 'bg-warning bg-opacity-10 border-warning' %> d-flex flex-column justify-content-between">
            <div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="small text-uppercase fw-bold text-secondary">
                  <i class="fa-solid fa-arrow-up-wide-short me-1"></i> End of Chain (Top)
                </span>
                <span class="badge <%= end_info[:badge_class] %>"><%= end_info[:label] %></span>
              </div>
              <h6 class="fw-bold text-dark mb-1">
                <%= end_info[:party_name] %>
              </h6>
              <p class="small text-muted mb-2">
                <%= end_info[:description] %>
              </p>
            </div>
            <% unless end_info[:closed] || policy(@chain).update? == false %>
              <div class="pt-2 border-top">
                <button type="button" class="btn btn-sm btn-outline-dark d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#connectPropertyModal" data-position="top">
                  <i class="fa-solid fa-magnifying-glass"></i>
                  <span>Find Vendor's Onward Property</span>
                </button>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Chain Status Explainer Alert -->
      <div class="mt-3">
        <% if @chain.chain_completed? %>
          <div class="alert alert-success d-flex align-items-center gap-2 mb-0 py-2">
            <i class="fa-solid fa-circle-check fs-5"></i>
            <span class="small">
              <strong>Chain Fully Completed:</strong> Both ends are closed (First-Time Buyer at start, vendor leaving property market at end) and all transactions in the chain have completed.
            </span>
          </div>
        <% elsif @chain.both_ends_closed? %>
          <div class="alert alert-info d-flex align-items-center gap-2 mb-0 py-2">
            <i class="fa-solid fa-circle-info fs-5"></i>
            <span class="small">
              <strong>Both Ends Closed (Chain In Progress):</strong> The start has a First-Time Buyer and the end vendor is leaving the property market. The chain is open while conveyancing proceeds on <%= pluralize(@chain.transactions.pending.size, 'transaction') %>.
            </span>
          </div>
        <% else %>
          <div class="alert alert-warning d-flex align-items-center gap-2 mb-0 py-2">
            <i class="fa-solid fa-triangle-exclamation fs-5"></i>
            <span class="small">
              <strong>Chain is Open:</strong> The chain boundaries are not yet closed. Connect the onward purchase at the top or the downward sale at the bottom to complete the chain links.
            </span>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Chain Sequence & Pipeline -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between flex-wrap gap-2">
      <h5 class="card-title fw-bold text-dark mb-0">
        <i class="fa-solid fa-arrows-split-up-and-left text-primary me-2"></i> Chain Sequence &amp; Cooperating Agents
      </h5>
      <div class="d-flex gap-2">
        <% if policy(@chain).update? && @connectable_properties.present? && @connectable_properties.any? %>
          <button type="button" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#connectPropertyModal">
            <i class="fa-solid fa-house-circle-check"></i>
            <span>Connect Property</span>
          </button>
        <% end %>
        <%= link_to new_transaction_path(chain_id: @chain.id), class: "btn btn-sm btn-primary d-inline-flex align-items-center gap-1" do %>
          <i class="fa-solid fa-plus"></i>
          <span>Add Transaction Link</span>
        <% end %>
      </div>
    </div>

    <div class="card-body p-4">
      <% ordered_txs = @chain.ordered_transactions %>
      <% if ordered_txs.empty? %>
        <div class="text-center py-4 text-muted">
          <i class="fa-solid fa-link-slash fa-2x mb-2 text-secondary opacity-50"></i>
          <p class="small mb-2">No transactions currently linked to this chain.</p>
          <%= link_to new_transaction_path(chain_id: @chain.id), class: "btn btn-sm btn-primary" do %>
            <i class="fa-solid fa-plus me-1"></i> Add First Transaction
          <% end %>
        </div>
      <% else %>
        <div class="position-relative">
          <% ordered_txs.each_with_index do |tx, idx| %>
            <div class="card border mb-4 shadow-none <%= 'border-success' if tx.completed? %>">
              <div class="card-header bg-light py-2 px-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <span class="badge bg-primary rounded-pill px-2 py-1">Step <%= idx + 1 %></span>
                  <span class="fw-bold text-dark">Transaction #<%= tx.id %></span>
                  <span class="badge <%= tx.status_badge_class %>"><%= tx.status_label %></span>
                  <span class="badge <%= tx.legal_stage_badge_class %>"
                        data-bs-toggle="tooltip"
                        data-bs-placement="top"
                        data-bs-title="<%= tx.legal_stage_definition[:tooltip] %>">
                    <i class="fa-solid <%= tx.legal_stage_definition[:icon] %> me-1"></i>
                    <%= tx.legal_stage_short_title %>
                  </span>
                  <span class="badge <%= tx.overall_timing_status[:badge_class] %>" style="font-size: 0.7rem;">
                    <%= tx.overall_timing_status[:label] %>
                  </span>
                </div>
                <div class="btn-group btn-group-sm">
                  <%= link_to transaction_path(tx), class: "btn btn-outline-primary" do %>
                    <i class="fa-solid fa-eye me-1"></i> View Details
                  <% end %>
                  <% if policy(tx).update? %>
                    <%= link_to edit_transaction_path(tx), class: "btn btn-outline-secondary" do %>
                      <i class="fa-solid fa-pen"></i>
                    <% end %>
                  <% end %>
                </div>
              </div>

              <div class="card-body p-3">
                <div class="row g-3">
                  <!-- Property Info -->
                  <div class="col-12 col-md-4 border-end-md">
                    <span class="text-muted small text-uppercase fw-semibold d-block mb-1">
                      <i class="fa-solid fa-house me-1 text-primary"></i> Property
                    </span>
                    <% if tx.property %>
                      <div class="d-flex align-items-start gap-2">
                        <%= link_to property_thumbnail(tx.property), property_path(tx.property) %>
                        <div>
                          <h6 class="fw-bold text-dark mb-1">
                            <%= link_to tx.property.short_address, property_path(tx.property), class: "text-decoration-none text-dark" %>
                          </h6>
                          <div class="text-muted small">
                            <%= tx.property.city %>, <%= tx.property.post_code %><br>
                            <span class="badge <%= tx.property.sold? ? 'bg-secondary' : 'bg-success-subtle text-success border border-success-subtle' %>">
                              <%= tx.property.sold? ? 'Sold' : 'Active Listing' %>
                            </span>
                          </div>
                        </div>
                      </div>
                    <% else %>
                      <span class="text-muted fst-italic small">No property assigned</span>
                    <% end %>
                  </div>

                  <!-- Managing Agent (Visible to all users for cooperation) -->
                  <div class="col-12 col-md-4 border-end-md">
                    <span class="text-muted small text-uppercase fw-semibold d-block mb-1">
                      <i class="fa-solid fa-user-tie me-1 text-primary"></i> Managing Agent
                    </span>
                    <% agent = tx.creator_or_listing_user %>
                    <% if agent %>
                      <div class="d-flex align-items-center gap-2 mb-1">
                        <%= agent_avatar(agent, size: 36) %>
                        <h6 class="fw-bold text-dark mb-0"><%= agent.user_name %></h6>
                      </div>
                      <div class="text-muted small">
                        <% if agent.company.present? %>
                          <span class="d-block"><i class="fa-solid fa-building me-1 text-secondary"></i><%= agent.company %></span>
                        <% end %>
                        <a href="mailto:<%= agent.email %>" class="text-decoration-none d-block">
                          <i class="fa-solid fa-envelope me-1 text-secondary"></i><%= agent.email %>
                        </a>
                        <% if agent.phone.present? %>
                          <a href="tel:<%= agent.phone %>" class="text-decoration-none d-block">
                            <i class="fa-solid fa-phone me-1 text-secondary"></i><%= agent.phone %>
                          </a>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-muted fst-italic small">Unassigned Agent</span>
                    <% end %>
                  </div>

                  <!-- Client / Purchaser Party -->
                  <div class="col-12 col-md-4">
                    <span class="text-muted small text-uppercase fw-semibold d-block mb-1">
                      <i class="fa-solid fa-user-group me-1 text-primary"></i> Purchaser (Buyer)
                    </span>
                    <% if tx.involved_party %>
                      <% if policy(tx.involved_party).show_personal_data? %>
                        <h6 class="fw-bold text-dark mb-1">
                          <%= link_to tx.involved_party.full_name, involved_party_path(tx.involved_party), class: "text-decoration-none text-dark" %>
                        </h6>
                        <div class="small text-muted">
                          <a href="mailto:<%= tx.involved_party.email %>" class="text-decoration-none d-block">
                            <i class="fa-solid fa-envelope me-1"></i><%= tx.involved_party.email %>
                          </a>
                          <a href="tel:<%= tx.involved_party.phone %>" class="text-decoration-none d-block">
                            <i class="fa-solid fa-phone me-1"></i><%= tx.involved_party.phone %>
                          </a>
                        </div>
                      <% else %>
                        <div class="p-2 bg-light rounded border text-center">
                          <i class="fa-solid fa-user-shield text-muted me-1"></i>
                          <span class="small fw-semibold text-muted">Client Confidential</span>
                          <p class="mb-0 text-muted" style="font-size: 0.72rem;">
                            Direct details restricted. Coordinate via <strong><%= agent&.user_name || "managing agent" %></strong>.
                          </p>
                        </div>
                      <% end %>
                    <% else %>
                      <span class="text-muted fst-italic small">No client party assigned</span>
                    <% end %>
                  </div>
                </div>
              </div>
            </div>

            <% unless idx == ordered_txs.size - 1 %>
              <div class="text-center my-3 text-muted">
                <i class="fa-solid fa-arrow-down fa-lg text-primary opacity-75"></i>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Connect Property to Chain Modal -->
<% if policy(@chain).update? %>
  <div class="modal fade" id="connectPropertyModal" tabindex="-1" aria-labelledby="connectPropertyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content border-0 shadow">
        <div class="modal-header bg-light">
          <div>
            <h5 class="modal-title fw-bold text-dark" id="connectPropertyModalLabel">
              <i class="fa-solid fa-house-circle-check text-primary me-2"></i> Connect Property to Chain
            </h5>
            <p class="text-muted small mb-0">Search for the property being purchased or sold to automatically connect or merge chains.</p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= form_with url: connect_property_chain_path(@chain), method: :post, local: true do |f| %>
          <div class="modal-body p-4">
            <div class="alert alert-info py-2 small mb-4">
              <i class="fa-solid fa-circle-info me-1"></i>
              <strong>Automatic Chain Linking:</strong> You only need to select the property. If the property is already part of another chain, Movee will automatically merge both chains under the <strong>lowest ID</strong> without requiring you to look up any chain numbers.
            </div>

            <!-- Position in Chain -->
            <div class="mb-4">
              <label class="form-label fw-semibold text-secondary small">Connection Position in Chain</label>
              <div class="row g-2">
                <div class="col-md-6">
                  <div class="form-check p-3 border rounded bg-light">
                    <input class="form-check-input ms-0 me-2" type="radio" name="position" id="posTop" value="top" checked>
                    <label class="form-check-label fw-semibold text-dark" for="posTop">
                      <i class="fa-solid fa-arrow-up-wide-short text-primary me-1"></i> Top of Chain (Onward Purchase)
                    </label>
                    <div class="text-muted small mt-1">
                      End vendor <%= @chain.end_transaction&.property&.involved_party&.full_name || 'at top' %> is buying this property.
                    </div>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="form-check p-3 border rounded bg-light">
                    <input class="form-check-input ms-0 me-2" type="radio" name="position" id="posBottom" value="bottom">
                    <label class="form-check-label fw-semibold text-dark" for="posBottom">
                      <i class="fa-solid fa-arrow-down-short-wide text-primary me-1"></i> Bottom of Chain (Downward Sale)
                    </label>
                    <div class="text-muted small mt-1">
                      Bottom purchaser <%= @chain.start_transaction&.involved_party&.full_name || 'at bottom' %> is selling this property.
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Property Selection / Search -->
            <div class="mb-3">
              <label for="propertySearchSelect" class="form-label fw-semibold text-secondary small">
                Select or Search Property <span class="text-danger">*</span>
              </label>
              <% if @connectable_properties.present? && @connectable_properties.any? %>
                <select name="property_id" id="propertySearchSelect" class="form-select form-select-lg" required>
                  <option value="">-- Choose a property to connect --</option>
                  <% @connectable_properties.each do |p| %>
                    <% other_c = p.chains.where.not(id: @chain.id).first || p.transactions.where.not(chain_id: @chain.id).first&.chain %>
                    <option value="<%= p.id %>">
                      <%= p.short_address %>, <%= p.city %> (<%= p.post_code %>)
                      <% if other_c %>
                        — [In Chain #<%= other_c.id %> - will merge under Chain #<%= [@chain.id, other_c.id].min %>]
                      <% elsif p.sold? %>
                        — [Sold Listing]
                      <% else %>
                        — [Active Listing - Agent: <%= p.user.user_name %>]
                      <% end %>
                    </option>
                  <% end %>
                </select>
                <div class="form-text small">
                  Select by address, city, postcode, or managing agent.
                </div>
              <% else %>
                <div class="alert alert-warning mb-0 small">
                  <i class="fa-solid fa-triangle-exclamation me-1"></i> No other properties are currently available to connect. <%= link_to "Create a new property", new_property_path, class: "alert-link" %> first.
                </div>
              <% end %>
            </div>
          </div>

          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
            <% if @connectable_properties.present? && @connectable_properties.any? %>
              <%= f.submit "Connect Property", class: "btn btn-primary px-4 shadow-sm" %>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('connectPropertyModal');
      if (modal) {
        modal.addEventListener('show.bs.modal', function(event) {
          const button = event.relatedTarget;
          if (button && button.dataset.position) {
            const radio = document.getElementById(button.dataset.position === 'bottom' ? 'posBottom' : 'posTop');
            if (radio) radio.checked = true;
          }
        });
      }
    });
  </script>
<% end %>
