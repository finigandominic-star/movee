<%= form_with model: chain, class: "needs-validation" do |f| %>
  <% if chain.errors.any? %>
    <div class="alert alert-danger mb-4">
      <h6 class="fw-bold mb-2"><i class="fa-solid fa-triangle-exclamation me-1"></i> Please fix the following errors:</h6>
      <ul class="mb-0 small ps-3">
        <% chain.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-4 form-check form-switch p-3 bg-light rounded-3 border">
    <div class="ms-4">
      <%= f.check_box :active, class: "form-check-input", role: "switch", id: "chainActiveSwitch" %>
      <%= f.label :active, "Active Chain", class: "form-check-label fw-bold text-dark", for: "chainActiveSwitch" %>
      <div class="form-text text-muted small mt-1">
        Active chains allow agents to link property transactions and coordinate across multiple parties.
      </div>
    </div>
  </div>

  <div class="d-flex gap-2 justify-content-end mt-4">
    <%= link_to "Cancel", chains_path, class: "btn btn-outline-secondary" %>
    <%= f.submit submit_label, class: "btn btn-primary shadow-sm" %>
  </div>
<% end %>
