<div class="container-fluid px-3 px-lg-5 py-4 py-lg-5 chains-index" data-controller="search-autocomplete" data-action="click@window->search-autocomplete#closeSuggestions">
  <div class="page-wide">
    <%= render layout: "shared/page_header", locals: { title: "Chains" } do %>
      <% if policy(Chain).create? %>
        <%= link_to new_chain_path, class: "btn btn-primary" do %>
          <i class="fa-solid fa-plus" aria-hidden="true"></i> New chain
        <% end %>
      <% end %>
    <% end %>

    <% if @chains.empty? && params[:q].blank? %>
      <%= render layout: "shared/empty_state", locals: { icon: "fa-link-slash", title: "No chains yet", text: "Chains appear when transactions are linked together. Start one to track a sale from first-time buyer to market exit." } do %>
        <% if policy(Chain).create? %>
          <%= link_to new_chain_path, class: "btn btn-primary" do %>
            <i class="fa-solid fa-plus" aria-hidden="true"></i> Create the first chain
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <div class="page-toolbar">
        <%= form_with url: chains_path, method: :get, class: "flex-grow-1", data: { turbo_frame: "_top" } do |f| %>
          <div class="input-group position-relative">
            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
            <%= f.search_field :q, value: params[:q], placeholder: "Search chains by name, address, or agent", class: "form-control", aria: { label: "Search chains" }, data: { search_autocomplete_target: "input", action: "input->search-autocomplete#filter focus->search-autocomplete#filter" } %>
            <%= link_to chains_path, class: "btn btn-outline-dark", hidden: params[:q].blank?, aria: { label: "Clear search" }, data: { search_autocomplete_target: "clear", action: "search-autocomplete#reset" } do %>
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            <% end %>
            <div class="search-suggestions" hidden data-search-autocomplete-target="suggestions" data-action="click->search-autocomplete#pick"></div>
          </div>
        <% end %>

        <ul class="nav nav-pills small" id="chainViewTab" role="tablist" aria-label="Choose list layout">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="table-tab" data-bs-toggle="pill" data-bs-target="#table-view" type="button" role="tab" aria-controls="table-view" aria-selected="true">
              <i class="fa-solid fa-table-list me-1" aria-hidden="true"></i> Table
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="cards-tab" data-bs-toggle="pill" data-bs-target="#cards-view" type="button" role="tab" aria-controls="cards-view" aria-selected="false">
              <i class="fa-solid fa-grip me-1" aria-hidden="true"></i> Cards
            </button>
          </li>
        </ul>
        <ul class="chain-flow-legend small text-muted" aria-label="Flow legend">
          <li><span class="chain-flow__dot chain-flow__dot--done" aria-hidden="true"></span>Completed</li>
          <li><span class="chain-flow__dot chain-flow__dot--active" aria-hidden="true"></span>In progress</li>
          <li><span class="chain-flow__dot chain-flow__dot--late" aria-hidden="true"></span>Behind</li>
          <li><span class="chain-flow__end chain-flow__end--open chain-flow__end--legend" aria-hidden="true"><i class="fa-solid fa-ellipsis"></i></span>Open end</li>
        </ul>
      </div>

      <% if @chains.empty? %>
        <p class="text-muted">No chains match "<%= params[:q] %>".</p>
      <% else %>

      <div class="tab-content" id="chainViewTabContent">
        <div class="tab-pane fade show active" id="table-view" role="tabpanel" aria-labelledby="table-tab" tabindex="0">
          <div class="table-responsive">
            <table class="table table-hover align-middle chain-table">
              <caption class="visually-hidden">Chains</caption>
              <thead>
                <tr>
                  <th scope="col">Chain</th>
                  <th scope="col">Flow (start → end)</th>
                  <th scope="col">Status</th>
                  <th scope="col">Created by</th>
                  <th scope="col" class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @chains.each do |chain| %>
                  <% chain_label = [chain_name(chain), chain.transactions.map { |t| t.property&.full_address }.compact.join(" "), chain.user&.user_name, chain.user&.company].compact.join(" ") %>
                  <tr data-search-autocomplete-target="item" data-name="<%= chain_label %>">
                    <td class="chain-table__name">
                      <%= link_to chain_name(chain), chain_path(chain), class: "fw-bold text-decoration-none" %>
                      <div class="small text-muted"><%= chain_summary(chain) %></div>
                    </td>
                    <td><%= render "chains/flow", chain: chain %></td>
                    <td>
                      <% if chain.chain_completed? %>
                        <span class="badge bg-success">Completed</span>
                      <% else %>
                        <span class="badge status-open">Open</span>
                      <% end %>
                    </td>
                    <td>
                      <% if chain.user %>
                        <div class="fw-medium"><%= agent_with_avatar(chain.user) %></div>
                        <% if chain.user.company.present? %>
                          <small class="text-muted"><%= chain.user.company %></small>
                        <% end %>
                      <% else %>
                        <span class="text-muted">—</span>
                      <% end %>
                    </td>
                    <td class="text-end">
                      <div class="chain-actions justify-content-end"><%= render "chains/actions", chain: chain %></div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </div>

        <div class="tab-pane fade" id="cards-view" role="tabpanel" aria-labelledby="cards-tab" tabindex="0">
          <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xxl-4 card-grid">
            <% @chains.each do |chain| %>
              <% done = chain.transactions.count(&:completed?) %>
              <% total = chain.transactions.size %>
              <% chain_label = [chain_name(chain), chain.transactions.map { |t| t.property&.full_address }.compact.join(" "), chain.user&.user_name, chain.user&.company].compact.join(" ") %>
              <div class="col" data-search-autocomplete-target="item" data-name="<%= chain_label %>">
                <div class="card record-card card--chain">
                  <div class="card-header">
                    <div>
                      <h2 class="record-card__title"><%= link_to chain_name(chain), chain_path(chain) %></h2>
                      <p class="record-card__subtitle"><%= chain_summary(chain) %></p>
                    </div>
                    <% if chain.chain_completed? %>
                      <span class="badge bg-success">Completed</span>
                    <% else %>
                      <span class="badge status-open">Open</span>
                    <% end %>
                  </div>

                  <div class="card-body">
                    <div class="position-relative z-2"><%= render "chains/flow", chain: chain, limit: 4 %></div>

                    <% if total.positive? %>
                      <div class="mt-auto">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                          <span>Completed</span>
                          <span class="fw-semibold"><%= done %> / <%= total %></span>
                        </div>
                        <div class="progress chain-progress" role="progressbar" aria-label="Completed links" aria-valuenow="<%= done %>" aria-valuemin="0" aria-valuemax="<%= total %>">
                          <div class="progress-bar" style="width: <%= (done * 100.0 / total).round %>%"></div>
                        </div>
                      </div>
                    <% end %>
                  </div>

                  <div class="card-footer chain-actions"><%= render "chains/actions", chain: chain %></div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <% end %>
    <% end %>
  </div>
</div>
