<div class="container py-4 py-lg-5">
  <div class="card card--chain form-shell">
    <div class="card-header py-3">
      <h1 class="h4 fw-bold mb-1">New chain</h1>
      <p class="small text-muted mb-0">Start an empty chain, then connect properties and transactions to it.</p>
    </div>
    <div class="card-body p-4">
      <%= render "form", chain: @chain, submit_label: "Create chain" %>
    </div>
  </div>
</div>
