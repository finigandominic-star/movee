<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">

      <!-- Breadcrumb Navigation -->
      <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
          <li class="breadcrumb-item"><%= link_to "Home", root_path, class: "text-decoration-none" %></li>
          <li class="breadcrumb-item"><%= link_to "Chains", chains_path, class: "text-decoration-none" %></li>
          <li class="breadcrumb-item active" aria-current="page">New Chain</li>
        </ol>
      </nav>

      <!-- Form Card -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
          <div class="d-flex align-items-center gap-2">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
              <i class="fa-solid fa-link"></i>
            </div>
            <h5 class="card-title mb-0 fw-bold text-dark">Create New Chain</h5>
          </div>
          <%= link_to chains_path, class: "btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1" do %>
            <i class="fa-solid fa-arrow-left"></i>
            <span>Back</span>
          <% end %>
        </div>

        <div class="card-body p-4">
          <%= form_with(model: @chain, local: true) do |f| %>
            <% if @chain.errors.any? %>
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <h6 class="alert-heading fw-bold">Please fix the following errors:</h6>
                <ul class="mb-0 ps-3 small">
                  <% @chain.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% end %>

            <div class="mb-4 px-3">
  <div class="form-check form-switch p-3 bg-light rounded border d-flex align-items-start gap-3">
    <%= f.check_box :active, class: "form-check-input fs-4 mt-1 ms-0 flex-shrink-0", role: "switch", id: "chainActiveSwitch" %>
    <div>
      <label class="form-check-label fw-semibold text-dark d-block mb-1" for="chainActiveSwitch">
        Active Chain
      </label>
      <div class="text-muted small">
        Active chains allow agents to link property transactions and coordinate across multiple parties.
      </div>
    </div>
  </div>
</div>

            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
              <%= link_to "Cancel", chains_path, class: "btn btn-outline-secondary px-4" %>
              <%= f.submit "Create Chain", class: "btn btn-primary px-4 shadow-sm" %>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</div>
