<%# "Fill from PDF": upload a client PDF, then show what happened with it.
    Locals: document (a ClientDocument, or nil), step (where it's uploaded, see ClientDocument::STEPS),
    carry (optional Hash of extra hidden fields to keep, e.g. the stepper's earlier choices) %>
<div class="fill-from-pdf border rounded-3 p-3 mb-4 bg-light">
  <% if document&.stuck? %>
    <div class="alert alert-warning mb-0" role="alert">
      <i class="fa-solid fa-hourglass-half me-2" aria-hidden="true"></i>
        Reading <strong><%= document.filename %></strong> is taking longer than expected.
        Please fill in the form by hand, or <%= link_to "check again", request.fullpath %> later.
    </div>
  <% elsif document&.processing? %>
    <p class="mb-0" role="status" data-controller="auto-reload">
      <i class="fa-solid fa-spinner fa-spin me-2" aria-hidden="true"></i>
      Reading <strong><%= document.filename %></strong>… This takes a few seconds.
      <%= link_to "Check again", request.fullpath, class: "ms-2" %>
    </p>
  <% else %>
    <% if document&.done? %>
      <% missing = fields_missing_from(document) %>
      <div class="alert alert-success mb-3" role="status">
        <i class="fa-solid fa-wand-magic-sparkles me-2" aria-hidden="true"></i>
        Filled in from <strong><%= document.filename %></strong>. Please check every field before continuing.
        <% if missing.any? %>
          <div class="small mt-1">Not found in the PDF: <%= missing.to_sentence %>.</div>
        <% end %>
      </div>
    <% elsif document&.failed? %>
      <div class="alert alert-danger mb-3" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2" aria-hidden="true"></i>
        We couldn't read <strong><%= document.filename %></strong>: <%= document.error_message %>
      </div>
    <% end %>

    <%= form_with url: client_documents_path, method: :post, local: true, multipart: true do %>
      <%# send step along with the upload, so the ClientDocumentsController knows where it came from and where to send the realtor back %>
      <%= hidden_field_tag :step, step, id: nil %>
      <%# local_assigns: hold all locals passed to a partial %>
      <%# fetch(:carry, {}): gives carry, if it was passed, and an empty Hash if not. makes carry optional:
          the client and property pages won't need it.%>
      <% local_assigns.fetch(:carry, {}).each do |key, value| %>
        <%= hidden_field_tag key, value, id: nil %>
      <% end %>
      <label class="form-label" for="clientPdf">Fill from PDF <span class="text-muted fw-normal">(optional)</span></label>
      <div class="input-group">
        <%= file_field_tag :file, accept: "application/pdf", id: "clientPdf", class: "form-control", required: true %>
        <button type="submit" class="btn btn-outline-primary">
          <i class="fa-solid fa-file-pdf" aria-hidden="true"></i> Read PDF
        </button>
      </div>
      <div class="form-text">
        We read the client's details from the PDF and filled in the form below. The PDF itself is not stored.</div>
    <% end %>
  <% end %>
</div>
