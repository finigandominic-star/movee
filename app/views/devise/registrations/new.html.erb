<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
      <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-4 p-sm-5">
          <!-- Header -->
          <div class="text-center mb-4">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
              <i class="fa-solid fa-user-plus fa-2x"></i>
            </div>
            <h2 class="fw-bold text-dark mb-1">Create Account</h2>
            <p class="text-muted small mb-0">Join Movee to manage your properties and transaction chains.</p>
          </div>

          <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= f.error_notification %>

            <div class="mb-3">
              <%= f.input :user_name,
                          required: true,
                          autofocus: true,
                          label: "Username",
                          placeholder: "e.g. alex_smith",
                          input_html: { class: "form-control" } %>
            </div>

            <div class="mb-3">
              <%= f.input :company,
                          required: false,
                          label: "Company / Agency",
                          placeholder: "e.g. Acme Properties",
                          input_html: { class: "form-control" } %>
            </div>

            <div class="mb-3">
              <%= f.input :phone,
                          required: false,
                          label: "Contact Phone Number",
                          placeholder: "e.g. +44 20 7946 0123",
                          input_html: { class: "form-control" } %>
            </div>

            <div class="mb-3">
              <%= f.input :email,
                          required: true,
                          label: "Email Address",
                          placeholder: "you@example.com",
                          input_html: { autocomplete: "email", class: "form-control" } %>
            </div>

            <div class="mb-3">
              <%= f.input :password,
                          required: true,
                          label: "Password",
                          hint: ("At least #{@minimum_password_length} characters (must include letters and numbers)" if @minimum_password_length),
                          placeholder: "••••••••",
                          input_html: { autocomplete: "new-password", class: "form-control" } %>
            </div>

            <div class="mb-4">
              <%= f.input :password_confirmation,
                          required: true,
                          label: "Confirm Password",
                          placeholder: "••••••••",
                          input_html: { autocomplete: "new-password", class: "form-control" } %>
            </div>

            <div class="d-grid mb-3">
              <%= f.button :submit, "Sign Up", class: "btn btn-primary py-2 fw-semibold shadow-sm" %>
            </div>
          <% end %>

          <!-- Footer Navigation -->
          <div class="text-center pt-3 border-top">
            <span class="text-muted small">Already have an account?</span>
            <%= link_to "Log In", new_session_path(resource_name), class: "text-decoration-none fw-semibold small ms-1" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
