<% content_for :title, "Log in" %>
<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 col-xl-5">
      <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-body p-4 p-sm-5">
          <!-- Header -->
          <div class="text-center mb-4">
            <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px;">
              <i class="fa-solid fa-right-to-bracket fa-2x"></i>
            </div>
            <h2 class="fw-bold text-dark mb-1">Welcome Back</h2>
            <p class="text-muted small mb-0">Log in to your Moveee account to continue.</p>
          </div>

          <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
            <div class="mb-3">
              <%= f.input :email,
                          required: true,
                          autofocus: true,
                          label: "Email Address",
                          placeholder: "you@example.com",
                          input_html: { autocomplete: "email", class: "form-control" } %>
            </div>

            <div class="mb-3">
              <%= f.input :password,
                          required: true,
                          label: "Password",
                          placeholder: "••••••••",
                          input_html: { autocomplete: "current-password", class: "form-control" } %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="mb-3 form-check">
                <%= f.check_box :remember_me, class: "form-check-input", id: "userRememberMe" %>
                <%= f.label :remember_me, "Remember me on this device", class: "form-check-label small text-muted", for: "userRememberMe" %>
              </div>
            <% end %>

            <div class="d-grid mb-3">
              <%= f.button :submit, "Log In", class: "btn btn-primary py-2 fw-semibold shadow-sm" %>
            </div>
          <% end %>

          <!-- Footer Links -->
          <div class="text-center pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="text-muted small">
              Don't have an account?
              <%= link_to "Sign Up", new_registration_path(resource_name), class: "text-decoration-none fw-semibold ms-1" %>
            </span>

            <% if devise_mapping.recoverable? %>
              <%= link_to "Forgot Password?", new_password_path(resource_name), class: "text-decoration-none small text-muted" %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
