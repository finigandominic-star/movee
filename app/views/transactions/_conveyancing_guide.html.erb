<%# UK conveyancing guide modal, opened from the tracker %>
<div class="modal fade legal-guide" id="legalExplainerModal" tabindex="-1" aria-labelledby="legalExplainerModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content border-0">
      <div class="modal-header legal-guide__header">
        <div>
          <h5 class="modal-title fw-bold mb-0" id="legalExplainerModalLabel">
            UK Conveyancing Guide &amp; Legal Stages
          </h5>
          <span class="small legal-guide__subtitle">England &amp; Wales conveyancing workflow after an offer is accepted</span>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4">
        <% current_def = @transaction.legal_stage_definition %>
        <% current_idx = @transaction.legal_stage_index %>
        <% curr_timing = @transaction.stage_timing(@transaction.legal_stage) %>

        <section class="legal-guide__current mb-4">
          <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-2">
            <div>
              <span class="active-stage-card__eyebrow">Current stage <%= current_idx %> of <%= Transaction::LEGAL_STAGES.size %></span>
              <h3 class="h5 fw-bold mt-1 mb-1">
                <i class="fa-solid <%= current_def[:icon] %> me-1" aria-hidden="true"></i><%= current_def[:name] %>
              </h3>
              <p class="text-muted small mb-0"><%= current_def[:summary] %></p>
            </div>
            <span class="badge <%= curr_timing[:badge_class] %>"><%= curr_timing[:label] %></span>
          </div>

          <dl class="row g-2 small my-2 pt-2 border-top mb-0">
            <div class="col-12 col-sm-6"><dt class="d-inline">Lead:</dt> <dd class="d-inline"><%= current_def[:lead_actor] %></dd></div>
            <div class="col-12 col-sm-6"><dt class="d-inline">Benchmark:</dt> <dd class="d-inline"><%= current_def[:timeline] %></dd></div>
            <div class="col-12 col-sm-6"><dt class="d-inline">Target date:</dt> <dd class="d-inline"><%= curr_timing[:estimated_date]&.strftime("%d %B %Y") || "—" %></dd></div>
            <div class="col-12 col-sm-6"><dt class="d-inline">Actual date:</dt> <dd class="d-inline"><%= curr_timing[:actual_date]&.strftime("%d %B %Y") || "In progress" %></dd></div>
          </dl>

          <div class="row g-3 mt-1">
            <div class="col-12 col-md-6">
              <div class="legal-guide__box h-100">
                <h4 class="legal-guide__box-title">Legal definition &amp; procedure</h4>
                <p class="small text-muted mb-0"><%= current_def[:legal_context] %></p>
              </div>
            </div>
            <div class="col-12 col-md-6">
              <div class="legal-guide__box legal-guide__box--action h-100">
                <h4 class="legal-guide__box-title">Agent action checklist</h4>
                <p class="small mb-0"><%= current_def[:agent_action] %></p>
              </div>
            </div>
          </div>
        </section>

        <p class="text-muted small mb-3">
          In England &amp; Wales, property sales remain <em>Subject to Contract (SSTC)</em> and non-binding until <strong>Exchange of Contracts</strong>. Estate agents play a vital sales-progression role across all 8 stages below:
        </p>

        <h3 class="form-section__title">All 8 conveyancing stages</h3>
        <div class="accordion legal-guide-card" id="modalStagesDetailedAccordion">
          <% Transaction::LEGAL_STAGES.each do |stage_key| %>
            <% stage_def = Transaction::LEGAL_STAGE_DEFINITIONS[stage_key] %>
            <% is_current = @transaction.legal_stage == stage_key %>

            <div class="accordion-item">
              <h2 class="accordion-header" id="modal_heading_<%= stage_key %>">
                <button class="accordion-button <%= 'collapsed' unless is_current %> py-3"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#modal_collapse_<%= stage_key %>"
                        aria-expanded="<%= is_current %>"
                        aria-controls="modal_collapse_<%= stage_key %>">
                  <span class="d-flex align-items-center justify-content-between w-100 me-3 flex-wrap gap-2">
                    <span class="d-flex align-items-center gap-2">
                      <span class="legal-guide__step-number"><%= stage_def[:index] %></span>
                      <span><%= stage_def[:name] %></span>
                      <% if is_current %>
                        <span class="badge bg-success">Active</span>
                      <% end %>
                    </span>
                    <span class="text-muted small fw-normal"><%= stage_def[:timeline] %> · <%= stage_def[:lead_actor] %></span>
                  </span>
                </button>
              </h2>

              <div id="modal_collapse_<%= stage_key %>"
                   class="accordion-collapse collapse <%= 'show' if is_current %>"
                   aria-labelledby="modal_heading_<%= stage_key %>"
                   data-bs-parent="#modalStagesDetailedAccordion">
                <div class="accordion-body p-3 p-md-4">
                  <div class="row g-3">
                    <div class="col-12 col-md-7">
                      <h4 class="legal-guide__box-title">Legal definition &amp; procedure</h4>
                      <p class="small text-muted mb-3"><%= stage_def[:legal_context] %></p>
                      <div class="legal-guide__box">
                        <h4 class="legal-guide__box-title">In short</h4>
                        <p class="small text-muted mb-0 fst-italic">"<%= stage_def[:tooltip] %>"</p>
                      </div>
                    </div>
                    <div class="col-12 col-md-5">
                      <div class="legal-guide__box legal-guide__box--action h-100">
                        <h4 class="legal-guide__box-title">Agent action &amp; chasing tip</h4>
                        <p class="small mb-0"><%= stage_def[:agent_action] %></p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="modal-footer py-2 px-3">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
