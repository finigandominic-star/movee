<% current_idx = @transaction.legal_stage_index %>
<% total_stages = Transaction::LEGAL_STAGES.size %>
<% percent = @transaction.legal_stage_percentage %>
<% current_def = @transaction.legal_stage_definition %>
<%# The public share-link page always passes can_update: false explicitly -
    never computed from the viewer's own session, which could belong to a
    signed-in agent/admin browsing in the same browser. %>
<% can_update = local_assigns.fetch(:can_update, policy(@transaction).update?) %>
<% can_share = local_assigns.fetch(:can_share, policy(@transaction).share_links?) %>
<% overall_timing = @transaction.overall_timing_status %>

<div class="card card--transaction mb-4" data-controller="tooltip">
  <div class="card-header d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
    <div>
      <h5 class="card-title h6 mb-0">
        <i class="fa-solid fa-scale-balanced me-2" aria-hidden="true"></i>UK Conveyancing Legal Stages
      </h5>
      <p class="text-muted small mb-0 mt-1">
        Stage <%= current_idx %> of <%= total_stages %> (<%= percent %>%) · England &amp; Wales conveyancing
      </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
      <% if can_share %>
        <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#shareStatusModal">
          <i class="fa-solid fa-share-nodes" aria-hidden="true"></i>
          <span>Share status with client</span>
        </button>
      <% end %>
      <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" data-bs-toggle="modal" data-bs-target="#legalExplainerModal">
        <i class="fa-solid fa-book-open" aria-hidden="true"></i>
        <span>Legal guide</span>
      </button>
    </div>
  </div>

  <div class="card-body p-4">
    <div class="mb-4">
      <div class="d-flex justify-content-between text-muted small mb-1 flex-wrap gap-1">
        <span>Offer agreed <strong class="text-body"><%= @transaction.transaction_start_date.strftime("%d %b %Y") %></strong></span>
        <span>Target completion <strong class="text-body"><%= @transaction.estimated_completion_date&.strftime("%d %b %Y") || "—" %></strong></span>
      </div>
      <div class="progress conveyancing-progress"
           role="progressbar"
           aria-label="Conveyancing progress"
           aria-valuenow="<%= percent %>"
           aria-valuemin="0"
           aria-valuemax="100">
        <div class="progress-bar <%= 'conveyancing-progress__bar--done' if @transaction.completed? %>" style="width: <%= percent %>%;"></div>
      </div>
    </div>

    <%# Stepper: hover a step for its milestone tooltip and dates (non-clickable) %>
    <div class="conveyancing-pipeline">
      <div class="conveyancing-pipeline__track">
        <% Transaction::LEGAL_STAGES.each do |stage_key| %>
          <% stage_def = Transaction::LEGAL_STAGE_DEFINITIONS[stage_key] %>
          <% s_idx = stage_def[:index] %>
          <% is_done = s_idx < current_idx %>
          <% is_current = s_idx == current_idx %>
          <% step_state = is_done ? "completed" : (is_current ? "current" : "pending") %>
          <% timing = @transaction.stage_timing(stage_key) %>
          <% est_date = timing[:estimated_date] %>
          <% act_date = timing[:actual_date] %>

          <% tooltip_title = "<strong>Stage #{s_idx}: #{ERB::Util.html_escape(stage_def[:name])}</strong><br>" \
                             "Lead: #{ERB::Util.html_escape(stage_def[:lead_actor])}<br>" \
                             "#{ERB::Util.html_escape(stage_def[:tooltip])}<br>" \
                             "<hr class='my-1'>" \
                             "<strong>Estimated date:</strong> #{est_date&.strftime('%d %b %Y')}<br>" \
                             "<strong>Actual date:</strong> #{act_date ? act_date.strftime('%d %b %Y') : (is_current ? 'In progress' : 'Pending')}<br>" \
                             "<strong>Status:</strong> #{timing[:full_label]}" %>

          <div class="conveyancing-pipeline__step conveyancing-pipeline__step--<%= step_state %>"
               data-bs-toggle="tooltip"
               data-bs-html="true"
               data-bs-placement="top"
               data-bs-title="<%= tooltip_title %>">
            <div class="conveyancing-pipeline__circle">
              <% if is_done %>
                <i class="fa-solid fa-check" aria-hidden="true"></i>
              <% elsif is_current %>
                <i class="fa-solid <%= stage_def[:icon] %>" aria-hidden="true"></i>
              <% else %>
                <span><%= s_idx %></span>
              <% end %>
            </div>
            <span class="conveyancing-pipeline__label"><%= stage_def[:short_name] %></span>
            <span class="conveyancing-pipeline__date <%= timing[:text_class] if is_current %>">
              <% if is_current && !@transaction.completed? %>
                <%= timing[:label] %>
              <% elsif act_date.present? %>
                Done <%= act_date.strftime("%d %b") %>
              <% else %>
                Est <%= est_date&.strftime("%d %b") %>
              <% end %>
            </span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="card active-stage-card <%= 'active-stage-card--completed' if @transaction.completed? %>">
      <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-3">
          <div>
            <span class="active-stage-card__eyebrow">Stage <%= current_idx %> · <%= current_def[:name] %></span>
            <p class="fw-bold fs-5 mt-1 mb-1"><%= current_def[:summary] %></p>
            <p class="text-muted small mb-0">
              Lead: <%= current_def[:lead_actor] %> · Benchmark: <%= current_def[:timeline] %>
            </p>
          </div>

          <% if can_update %>
            <div class="d-flex flex-column flex-sm-row gap-2 align-items-stretch align-items-sm-center">
              <% if @transaction.next_legal_stage %>
                <% nxt_def = Transaction::LEGAL_STAGE_DEFINITIONS[@transaction.next_legal_stage] %>
                <%= button_to update_stage_transaction_path(@transaction),
                              method: :patch,
                              params: { legal_stage: @transaction.next_legal_stage },
                              class: "btn btn-primary text-nowrap",
                              data: { bs_toggle: "tooltip", bs_title: "Advance transaction to Stage #{nxt_def[:index]}: #{nxt_def[:name]}" } do %>
                  <span>Advance to stage <%= nxt_def[:index] %></span>
                  <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                <% end %>
              <% end %>

              <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle w-100"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                  <i class="fa-solid fa-list-check" aria-hidden="true"></i>
                  <span>Change stage</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li><h6 class="dropdown-header">Select conveyancing stage</h6></li>
                  <% Transaction::LEGAL_STAGES.each do |stg| %>
                    <% s_def = Transaction::LEGAL_STAGE_DEFINITIONS[stg] %>
                    <% is_active = @transaction.legal_stage == stg %>
                    <li>
                      <%= button_to update_stage_transaction_path(@transaction),
                                    method: :patch,
                                    params: { legal_stage: stg },
                                    class: "dropdown-item d-flex align-items-center justify-content-between py-2 #{'active fw-bold' if is_active}" do %>
                        <span>
                          <i class="fa-solid <%= s_def[:icon] %> me-2" aria-hidden="true"></i>
                          <%= s_def[:index] %>. <%= s_def[:short_name] %>
                        </span>
                        <% if is_active %>
                          <i class="fa-solid fa-check ms-2" aria-hidden="true"></i>
                        <% end %>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </div>
            </div>
          <% end %>
        </div>

        <% curr_timing = @transaction.stage_timing(@transaction.legal_stage) %>
        <dl class="row g-2 mb-0 active-stage-card__dates">
          <div class="col-12 col-sm-4">
            <dt>Stage target</dt>
            <dd><%= curr_timing[:estimated_date]&.strftime("%d %B %Y") || "—" %></dd>
          </div>
          <div class="col-12 col-sm-4">
            <dt>Stage reached</dt>
            <dd class="<%= 'text-muted fst-italic' unless curr_timing[:actual_date] %>"><%= curr_timing[:actual_date]&.strftime("%d %B %Y") || "In progress" %></dd>
          </div>
          <div class="col-12 col-sm-4">
            <dt>Target status</dt>
            <dd class="<%= curr_timing[:text_class] %>"><%= curr_timing[:full_label] %></dd>
          </div>
        </dl>

        <% if @transaction.completed? %>
          <div class="alert alert-success d-flex align-items-start gap-2 mt-3 mb-0" role="alert">
            <i class="fa-solid fa-circle-check fs-4" aria-hidden="true"></i>
            <div>
              <strong>Transaction completed.</strong> Keys have been released to the buyer and legal completion is finalised.
              <span class="d-block small mt-1">
                Completed on <strong><%= @transaction.actual_completion_date&.strftime("%d %B %Y") || @transaction.updated_at.strftime("%d %B %Y") %></strong>
                (<%= overall_timing[:label] %> relative to target date <%= @transaction.estimated_completion_date&.strftime("%d %B %Y") %>).
              </span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
