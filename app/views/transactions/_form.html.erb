<%= form_with model: transaction, local: true, class: "needs-validation" do |f| %>
  <% if transaction.errors.any? %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <h2 class="alert-heading h6 fw-bold mb-2">
        <i class="fa-solid fa-triangle-exclamation me-1" aria-hidden="true"></i>
        <%= pluralize(transaction.errors.count, "error") %> prohibited this transaction from being saved:
      </h2>
      <ul class="mb-0 small ps-3">
        <% transaction.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

  <% if @unlinked_chains.present? %>
    <div class="alert alert-warning" role="alert">
      <h2 class="alert-heading h6 fw-bold mb-2">
        <i class="fa-solid fa-link-slash me-1" aria-hidden="true"></i>
        This buyer is selling a property in another chain
      </h2>
      <p class="small mb-2">
        <%= transaction.involved_party&.full_name %> is already selling in
        <%= safe_join(@unlinked_chains.map { |c| link_to(chain_name(c), chain_path(c), class: "alert-link", target: "_blank", rel: "noopener") }, ", ") %>,
        but this transaction isn't in that chain, so the two chains will stay separate.
      </p>
      <p class="small mb-0">Press <strong>Link the chains and save</strong> to merge them into one chain, or <strong>Proceed anyway</strong> to keep them separate.</p>
    </div>
  <% end %>

  <section class="form-section">
    <h2 class="form-section__title">Deal</h2>

    <div class="mb-3">
      <%= f.label :property_id, class: "form-label" do %>
        Property <span class="text-danger">*</span>
      <% end %>
      <% if Property.any? %>
        <%= f.collection_select :property_id,
            Property.all,
            :id,
            ->(p) { "#{p.short_address}, #{p.city} (#{p.post_code})" },
            { prompt: "Select a property" },
            { class: "form-select #{'is-invalid' if transaction.errors[:property].any?}", required: true, autofocus: true } %>
        <% if transaction.errors[:property].any? %>
          <div class="invalid-feedback"><%= transaction.errors[:property].first %></div>
        <% end %>
      <% else %>
        <div class="alert alert-warning mb-0" role="alert">
          <strong>No properties available.</strong> You must <%= link_to "create a property", new_property_path, class: "alert-link" %> before recording a transaction.
        </div>
      <% end %>
    </div>

    <div class="mb-3">
      <%= f.label :involved_party_id, "Buyer", class: "form-label", for: "buyerSearch" %>
      <% if InvolvedParty.any? %>
        <% selected_buyer_id = (transaction.involved_party_id || params[:involved_party_id]).to_i %>
        <div data-controller="client-search" data-action="change->client-search#choose click@window->client-search#closeOnOutsideClick">
          <div class="input-group mb-2">
            <span class="input-group-text"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span>
            <input type="search" id="buyerSearch" class="form-control" placeholder="Search by name or email, or browse all clients…" autocomplete="off"
                   data-client-search-target="input" data-action="input->client-search#filter focus->client-search#show">
            <button type="button" class="btn btn-outline-secondary" aria-controls="buyerChoices" aria-expanded="false"
                    aria-label="Show all clients" data-client-search-target="toggle" data-action="client-search#toggle">
              <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
          </div>
          <div class="choice-list <%= 'is-invalid' if transaction.errors[:involved_party].any? %>" id="buyerChoices">
            <div data-client-search-target="item" data-name="No buyer yet">
              <%= render "sales/choice", name: "transaction[involved_party_id]", value: "", id: "buyer_none",
                    checked: selected_buyer_id.zero?, title: "No buyer yet" %>
            </div>
            <% InvolvedParty.order(:first_name, :last_name).each do |ip| %>
              <div data-client-search-target="item" data-name="<%= ip.full_name %> <%= ip.email %>">
                <%= render "sales/choice", name: "transaction[involved_party_id]", value: ip.id, id: "buyer_#{ip.id}",
                      checked: selected_buyer_id == ip.id, title: ip.full_name, meta: "#{ip.roles_label} · #{ip.email}" %>
              </div>
            <% end %>
          </div>
          <p class="text-muted small mb-0" data-client-search-target="empty" hidden>No clients match that search.</p>
          <% if transaction.errors[:involved_party].any? %>
            <div class="invalid-feedback d-block"><%= transaction.errors[:involved_party].first %></div>
          <% end %>
        </div>
      <% else %>
        <div class="alert alert-light border mb-0 d-flex align-items-center justify-content-between flex-wrap gap-2" role="alert">
          <span class="text-muted small">No clients registered yet. You can record this transaction now and add the buyer later.</span>
          <%= link_to "Add client", new_involved_party_path, class: "btn btn-sm btn-outline-primary" %>
        </div>
      <% end %>
    </div>

    <div class="mb-3">
      <%= f.label :chain_id, "Chain", class: "form-label" %>
      <%= f.collection_select :chain_id,
          Chain.includes(transactions: :property).order(:id),
          :id,
          ->(c) { "#{chain_name(c)} (Chain ##{c.id})" },
          { include_blank: "Start a new chain" },
          { class: "form-select" } %>
    </div>
  </section>

  <section class="form-section">
    <h2 class="form-section__title">Progress</h2>

    <div class="mb-3">
      <%= f.label :legal_stage, class: "form-label" do %>
        Conveyancing stage <span class="text-danger">*</span>
      <% end %>
      <%= f.select :legal_stage,
          Transaction::LEGAL_STAGES.map { |stg|
            d = Transaction::LEGAL_STAGE_DEFINITIONS[stg]
            ["Step #{d[:index]}: #{d[:name]} (#{d[:timeline]})", stg]
          },
          {},
          { class: "form-select #{'is-invalid' if transaction.errors[:legal_stage].any?}" } %>
      <% if transaction.errors[:legal_stage].any? %>
        <div class="invalid-feedback"><%= transaction.errors[:legal_stage].first %></div>
      <% end %>
      <% if transaction.persisted? %>
        <button type="button" class="btn btn-link btn-sm px-0 mt-1" data-bs-toggle="modal" data-bs-target="#legalExplainerModal">
          <i class="fa-solid fa-book-open me-1" aria-hidden="true"></i>Open the conveyancing guide
        </button>
      <% end %>
    </div>

    <div class="mb-3">
      <%= f.label :estimated_completion_date, "Target completion date", class: "form-label" %>
      <%= f.date_field :estimated_completion_date, class: "form-control" %>
      <div class="form-text">Optional — defaults to 12 weeks from creation.</div>
    </div>
  </section>

  <div class="form-actions">
    <%= link_to "Cancel", (transaction.persisted? ? transaction_path(transaction) : transactions_path), class: "btn btn-outline-secondary" %>
    <% if @unlinked_chains.present? %>
      <%= f.button name: "merge_chains", value: "1", class: "btn btn-primary" do %>
        <i class="fa-solid fa-link" aria-hidden="true"></i>
        <span>Link the chains and save</span>
      <% end %>
      <%= f.button name: "confirm_unlinked", value: "1", class: "btn btn-outline-secondary" do %>
        <span>Proceed anyway</span>
      <% end %>
    <% else %>
      <%= f.button class: "btn btn-primary" do %>
        <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
        <span><%= local_assigns[:submit_label] || (transaction.persisted? ? "Update transaction" : "Save transaction") %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
