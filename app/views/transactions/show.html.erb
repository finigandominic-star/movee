<% property = @transaction.property %>
<% chain = @transaction.chain %>
<% party = @transaction.involved_party %>
<% agent = @transaction.creator_or_listing_user %>
<% can_update = policy(@transaction).update? %>

<div class="container py-4 py-lg-5" data-controller="tooltip">
  <% subtitle = safe_join(["Transaction ##{@transaction.id} · Chain: #{chain_name(chain)}", " ", render("transactions/status_tag", tx: @transaction)]) %>
  <%= render layout: "shared/page_header", locals: { title: property&.short_address || "Transaction ##{@transaction.id}", subtitle: subtitle } do %>
    <% if party.nil? && can_update %>
      <%= link_to edit_transaction_path(@transaction), class: "btn btn-accent" do %>
        <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
        <span>Add buyer</span>
      <% end %>
    <% else %>
      <%= link_to chain_path(chain), class: "btn btn-accent" do %>
        <i class="fa-solid fa-link" aria-hidden="true"></i>
        <span>View chain</span>
      <% end %>
    <% end %>
    <% if can_update %>
      <%= link_to edit_transaction_path(@transaction), class: "btn btn-outline-primary" do %>
        <i class="fa-solid fa-pen" aria-hidden="true"></i>
        <span>Edit</span>
      <% end %>
    <% end %>
    <% if policy(@transaction).destroy? %>
      <%= link_to icon_label("fa-trash-can", "Delete transaction"), transaction_path(@transaction), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete Transaction ##{@transaction.id}?" }, class: "btn btn-outline-danger btn-icon" %>
    <% end %>
  <% end %>

  <div class="row g-4">
    <div class="col-12 col-lg-8">
      <%= render "conveyancing_tracker" %>
      <%= render "conveyancing_guide" %>

      <div class="card card--property mb-4">
        <div class="card-header d-flex align-items-center justify-content-between">
          <h2 class="h6 mb-0"><i class="fa-solid fa-house me-2" aria-hidden="true"></i>Property</h2>
          <% if property %>
            <%= link_to "View property", property_path(property), class: "btn btn-sm btn-outline-primary" %>
          <% end %>
        </div>
        <div class="card-body p-4">
          <% if property %>
            <div class="row g-3 align-items-center">
              <% if property.photo.attached? %>
                <div class="col-12 col-md-4">
                  <%= image_tag property.photo, class: "img-fluid rounded object-fit-cover w-100 transaction-property__photo", alt: property.short_address %>
                </div>
              <% end %>
              <div class="col-12 <%= 'col-md-8' if property.photo.attached? %>">
                <p class="fw-bold mb-1"><%= property.short_address %></p>
                <% if property.second_line_of_address.present? %>
                  <p class="text-muted small mb-1"><%= property.second_line_of_address %></p>
                <% end %>
                <p class="text-muted small mb-2"><%= property.city %>, <%= property.post_code %></p>
                <% if property.sold? %>
                  <span class="badge bg-secondary">Sold</span>
                <% else %>
                  <span class="badge bg-success">Available for sale</span>
                <% end %>
              </div>
            </div>
          <% else %>
            <p class="text-muted mb-0 fst-italic">No property linked to this transaction.</p>
          <% end %>
        </div>
      </div>

      <div class="card card--chain mb-4">
        <div class="card-header d-flex align-items-center justify-content-between gap-2">
          <div>
            <h2 class="h6 mb-0"><i class="fa-solid fa-link me-2" aria-hidden="true"></i><%= chain_name(chain) %></h2>
            <span class="small text-muted">Chain #<%= chain.id %> · <%= chain.active? ? "Active" : "Inactive" %> · <%= pluralize(chain.transactions.count, "transaction") %></span>
          </div>
          <%= link_to "View chain", chain_path(chain), class: "btn btn-sm btn-outline-primary text-nowrap" %>
        </div>
        <div class="card-body p-4">
          <% others = chain.transactions.where.not(id: @transaction.id) %>
          <% if others.any? %>
            <h3 class="form-section__title">Other transactions in this chain</h3>
            <ul class="list-group list-group-flush small">
              <% others.each do |other_tx| %>
                <% other_agent = other_tx.creator_or_listing_user %>
                <li class="list-group-item px-0 py-3 d-flex justify-content-between align-items-start gap-3">
                  <div>
                    <%= link_to other_tx.property&.short_address || "Transaction ##{other_tx.id}", transaction_path(other_tx), class: "fw-semibold text-decoration-none" %>
                    <span class="text-muted">· #<%= other_tx.id %></span>
                    <% if other_agent %>
                      <div class="text-muted mt-1">
                        <%= agent_with_avatar(other_agent, name_class: "fw-bold text-body") %><%= " (#{other_agent.company})" if other_agent.company.present? %>
                        <div>
                          <a href="mailto:<%= other_agent.email %>" class="text-decoration-none me-2"><%= other_agent.email %></a>
                          <% if other_agent.phone.present? %>
                            <a href="tel:<%= other_agent.phone %>" class="text-decoration-none"><%= other_agent.phone %></a>
                          <% end %>
                        </div>
                      </div>
                    <% end %>
                  </div>
                  <%= render "transactions/status_tag", tx: other_tx, stage: true %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-muted mb-0">This is the only transaction in the chain so far.</p>
          <% end %>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <div class="card card--transaction mb-4">
        <div class="card-header">
          <h2 class="h6 mb-0"><i class="fa-solid fa-user-tie me-2" aria-hidden="true"></i>Managing agent</h2>
        </div>
        <div class="card-body p-4">
          <% if agent %>
            <div class="d-flex align-items-center gap-3 mb-3">
              <%= agent_avatar(agent) %>
              <div>
                <p class="fw-bold mb-0"><%= agent.user_name %></p>
                <p class="text-muted small mb-0"><%= agent.company.presence || "Estate agent" %></p>
              </div>
            </div>
            <dl class="mb-0 d-flex flex-column gap-2">
              <div class="record-meta">
                <dt>Email</dt>
                <dd><a href="mailto:<%= agent.email %>" class="text-decoration-none"><%= agent.email %></a></dd>
              </div>
              <% if agent.phone.present? %>
                <div class="record-meta">
                  <dt>Phone</dt>
                  <dd><a href="tel:<%= agent.phone %>" class="text-decoration-none"><%= agent.phone %></a></dd>
                </div>
              <% end %>
            </dl>
          <% else %>
            <p class="text-muted mb-0 small fst-italic">No agent assigned to this transaction.</p>
          <% end %>
        </div>
      </div>

      <div class="card card--party mb-4">
        <div class="card-header">
          <h2 class="h6 mb-0"><i class="fa-solid fa-user me-2" aria-hidden="true"></i>Buyer</h2>
        </div>
        <div class="card-body p-4">
          <% if party %>
            <% if policy(party).show_personal_data? %>
              <p class="fw-bold mb-3"><%= link_to party.full_name, involved_party_path(party), class: "text-decoration-none" %></p>
              <dl class="mb-0 d-flex flex-column gap-2">
                <% if party.phone.present? %>
                  <div class="record-meta">
                    <dt>Phone</dt>
                    <dd><a href="tel:<%= party.phone %>" class="text-decoration-none"><%= party.phone %></a></dd>
                  </div>
                <% end %>
                <% if party.email.present? %>
                  <div class="record-meta">
                    <dt>Email</dt>
                    <dd><a href="mailto:<%= party.email %>" class="text-decoration-none"><%= party.email %></a></dd>
                  </div>
                <% end %>
              </dl>
              <% if party.contact_info.present? %>
                <p class="small text-muted bg-light rounded p-2 mt-3 mb-0"><%= party.contact_info %></p>
              <% end %>
            <% else %>
              <div class="text-center">
                <span class="badge bg-light mb-2"><i class="fa-solid fa-user-shield me-1" aria-hidden="true"></i>Confidential Client</span>
                <p class="small text-muted mb-0">Personal contact details are protected. Contact the managing agent<%= " #{agent.user_name}" if agent %> instead.</p>
              </div>
            <% end %>

            <% if can_update %>
              <div class="mt-3 pt-3 border-top">
                <%= button_to remove_involved_party_transaction_path(@transaction), method: :delete, data: { turbo_confirm: "Unassign #{party.full_name} from this transaction?" }, class: "btn btn-sm btn-outline-danger w-100" do %>
                  <i class="fa-solid fa-user-xmark" aria-hidden="true"></i>
                  <span>Remove buyer</span>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <p class="small text-muted mb-2">No buyer assigned yet.</p>
            <% if can_update %>
              <%= link_to edit_transaction_path(@transaction), class: "btn btn-sm btn-outline-primary" do %>
                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>
                <span>Add buyer</span>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
