<%# The single status tag for a transaction. Completed and overdue always win;
    pass stage: true (lists) to show the current stage instead of "On course". %>
<% timing = tx.overall_timing_status %>
<% tooltip = timing[:full_label] || timing[:label] %>
<% if tx.completed? %>
  <span class="badge bg-success" data-bs-toggle="tooltip" data-bs-title="<%= tooltip %>">
    <i class="fa-solid fa-flag-checkered me-1" aria-hidden="true"></i>Completed
  </span>
<% elsif timing[:status] == :behind || timing[:status] == :overdue %>
  <% days_over = [(timing[:days_over] || timing[:days] || timing[:days_diff]&.abs).to_i, 1].max %>
  <span class="badge bg-danger" data-bs-toggle="tooltip" data-bs-title="<%= tooltip %>">
    <i class="fa-solid fa-circle-exclamation me-1" aria-hidden="true"></i>+<%= days_over %>d Over
  </span>
<% elsif local_assigns[:stage] %>
  <span class="badge bg-info" data-bs-toggle="tooltip" data-bs-title="<%= tx.legal_stage_definition[:tooltip] %>">
    <%= tx.legal_stage_short_title %>
  </span>
<% elsif timing[:status] == :ahead %>
  <span class="badge bg-success" data-bs-toggle="tooltip" data-bs-title="<%= tooltip %>">
    <i class="fa-solid fa-bolt me-1" aria-hidden="true"></i><%= [timing[:days].to_i, 1].max %>d Ahead
  </span>
<% else %>
  <span class="badge bg-info" data-bs-toggle="tooltip" data-bs-title="<%= tooltip %>">
    <i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>On course
  </span>
<% end %>
