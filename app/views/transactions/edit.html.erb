<div class="container py-4 py-lg-5">
  <div class="card card--transaction form-shell">
    <div class="card-header">
      <h1 class="h3 mb-1">Edit transaction #<%= @transaction.id %></h1>
      <p class="text-muted small mb-0"><%= @transaction.property&.short_address || "Update the property, buyer, chain or stage." %></p>
    </div>
    <div class="card-body p-4">
      <%= render "transactions/form", transaction: @transaction, submit_label: "Update transaction" %>
    </div>
  </div>
</div>

<%= render "transactions/conveyancing_guide" %>
