<div class="container py-4 py-lg-5">
  <div class="card card--transaction form-shell">
    <div class="card-header">
      <h1 class="h3 mb-1">New transaction</h1>
      <p class="text-muted small mb-0">Link a property, its buyer and a chain to start tracking conveyancing.</p>
    </div>
    <div class="card-body p-4">
      <%= render "transactions/form", transaction: @transaction, submit_label: "Create transaction" %>
    </div>
  </div>
</div>
