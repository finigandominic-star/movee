<div class="container py-4 py-lg-5" data-controller="tooltip">
  <%= render layout: "shared/page_header", locals: { title: "Transactions" } do %>
    <%= link_to new_transaction_path, class: "btn btn-primary" do %>
      <i class="fa-solid fa-plus" aria-hidden="true"></i>
      <span>New transaction</span>
    <% end %>
  <% end %>

  <% if @transactions.empty? %>
    <%= render layout: "shared/empty_state", locals: { icon: "fa-file-signature", title: "No transactions yet", text: "Track a sale through conveyancing by recording your first transaction." } do %>
      <%= link_to new_transaction_path, class: "btn btn-primary" do %>
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        <span>New transaction</span>
      <% end %>
    <% end %>
  <% else %>
    <div class="page-toolbar">
      <ul class="nav nav-pills small" id="transactionViewTabs" role="tablist" aria-label="Choose list layout">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="cards-tab" data-bs-toggle="pill" data-bs-target="#cards-view" type="button" role="tab" aria-controls="cards-view" aria-selected="true">
            <i class="fa-solid fa-grip me-1" aria-hidden="true"></i>Cards
          </button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="table-tab" data-bs-toggle="pill" data-bs-target="#table-view" type="button" role="tab" aria-controls="table-view" aria-selected="false">
            <i class="fa-solid fa-table-list me-1" aria-hidden="true"></i>Table
          </button>
        </li>
      </ul>
    </div>

    <div class="tab-content" id="transactionViewTabsContent">
      <div class="tab-pane fade show active" id="cards-view" role="tabpanel" aria-labelledby="cards-tab" tabindex="0">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xxl-4 card-grid">
          <% @transactions.each do |tx| %>
            <% party = tx.involved_party %>
            <% agent = tx.creator_or_listing_user %>
            <div class="col">
              <div class="card record-card card--transaction">
                <% if tx.property&.photo&.attached? %>
                  <%= image_tag tx.property.photo, class: "record-card__image", alt: tx.property.short_address %>
                <% else %>
                  <div class="record-card__image record-card__image--empty" aria-hidden="true">
                    <i class="fa-solid fa-house"></i>
                  </div>
                <% end %>
                <div class="card-header">
                  <div>
                    <h2 class="record-card__title">
                      <%= link_to tx.property&.short_address || "Transaction ##{tx.id}", transaction_path(tx) %>
                    </h2>
                    <p class="record-card__subtitle">Chain: <%= chain_name(tx.chain) %></p>
                  </div>
                  <%= render "transactions/status_tag", tx: tx, stage: true %>
                </div>

                <div class="card-body">
                  <dl class="mb-0 d-flex flex-column gap-2">
                    <div class="record-meta">
                      <dt>Buyer</dt>
                      <dd>
                        <% if party.nil? %>
                          <span class="text-muted">Not assigned</span>
                        <% elsif policy(party).show_personal_data? %>
                          <%= party.full_name %>
                        <% else %>
                          <span class="badge bg-light"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Protected Client</span>
                        <% end %>
                      </dd>
                    </div>
                    <div class="record-meta">
                      <dt>Stage</dt>
                      <dd><%= tx.legal_stage_index %>/<%= Transaction::LEGAL_STAGES.size %> · <%= tx.legal_stage_short_title %></dd>
                    </div>
                    <div class="record-meta">
                      <dt>Target completion</dt>
                      <dd><%= tx.estimated_completion_date&.strftime("%d %b %Y") || "—" %></dd>
                    </div>
                    <% if agent %>
                      <div class="record-meta">
                        <dt>Agent</dt>
                        <dd title="<%= agent.email %>"><%= agent_with_avatar(agent) %></dd>
                      </div>
                    <% end %>
                  </dl>
                </div>

                <% if policy(tx).update? || policy(tx).destroy? %>
                  <div class="card-footer">
                    <% if policy(tx).update? %>
                      <%= link_to icon_label("fa-pen", "Edit transaction ##{tx.id}"), edit_transaction_path(tx), class: "btn btn-sm btn-outline-secondary btn-icon" %>
                    <% end %>
                    <% if policy(tx).destroy? %>
                      <%= link_to icon_label("fa-trash-can", "Delete transaction ##{tx.id}"), transaction_path(tx), data: { turbo_method: :delete, turbo_confirm: "Delete this transaction?" }, class: "btn btn-sm btn-outline-danger btn-icon" %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <div class="tab-pane fade" id="table-view" role="tabpanel" aria-labelledby="table-tab" tabindex="0">
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <caption class="visually-hidden">Transactions</caption>
            <thead>
              <tr>
                <th scope="col">Property</th>
                <th scope="col">Buyer</th>
                <th scope="col">Agent</th>
                <th scope="col">Chain</th>
                <th scope="col">Stage &amp; Schedule</th>
                <th scope="col" class="text-end">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% @transactions.each do |tx| %>
                <% party = tx.involved_party %>
                <% agent = tx.creator_or_listing_user %>
                <tr>
                  <td>
                    <%= link_to tx.property&.short_address || "Transaction ##{tx.id}", transaction_path(tx), class: "fw-semibold text-decoration-none" %>
                    <small class="text-muted d-block">#<%= tx.id %><%= " · #{tx.property.post_code}" if tx.property&.post_code.present? %></small>
                  </td>
                  <td>
                    <% if party.nil? %>
                      <span class="text-muted">—</span>
                    <% elsif policy(party).show_personal_data? %>
                      <%= party.full_name %>
                      <small class="text-muted d-block"><%= party.email %></small>
                    <% else %>
                      <span class="badge bg-light"><i class="fa-solid fa-lock me-1" aria-hidden="true"></i>Protected Client</span>
                    <% end %>
                  </td>
                  <td>
                    <% if agent %>
                      <%= agent_with_avatar(agent, name_class: "fw-medium") %>
                    <% else %>
                      <span class="text-muted">—</span>
                    <% end %>
                  </td>
                  <td>
                    <%= link_to chain_name(tx.chain), chain_path(tx.chain), class: "text-decoration-none" %>
                    <small class="text-muted d-block">Chain #<%= tx.chain.id %></small>
                  </td>
                  <td>
                    <%= render "transactions/status_tag", tx: tx, stage: true %>
                    <small class="text-muted d-block mt-1">
                      Stage <%= tx.legal_stage_index %>/<%= Transaction::LEGAL_STAGES.size %> · target <%= tx.estimated_completion_date&.strftime("%d %b %Y") || "—" %>
                    </small>
                  </td>
                  <td class="text-end text-nowrap">
                    <%= link_to icon_label("fa-eye", "View transaction ##{tx.id}"), transaction_path(tx), class: "btn btn-sm btn-outline-primary btn-icon" %>
                    <% if policy(tx).update? %>
                      <%= link_to icon_label("fa-pen", "Edit transaction ##{tx.id}"), edit_transaction_path(tx), class: "btn btn-sm btn-outline-secondary btn-icon" %>
                    <% end %>
                    <% if policy(tx).destroy? %>
                      <%= link_to icon_label("fa-trash-can", "Delete transaction ##{tx.id}"), transaction_path(tx), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete Transaction ##{tx.id}?" }, class: "btn btn-sm btn-outline-danger btn-icon" %>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  <% end %>
</div>
